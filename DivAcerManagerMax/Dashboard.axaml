<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DivAcerManagerMax.Dashboard"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:local="using:DivAcerManagerMax"
             xmlns:divAcerManagerMax="clr-namespace:DivAcerManagerMax"
             xmlns:avalonia="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             x:DataType="divAcerManagerMax:Dashboard">

    <!--
        Dashboard tab. Telemetry (CPU / GPU / battery / history) is bound to this control.
        The thermal-profile and fan-control cards are driven by MainWindow, which looks the
        named controls up in this control's name scope (see MainWindow.FindInScopes).
    -->

    <UserControl.Styles>
        <!-- One metric: LABEL ........ VALUE UNIT, segmented bar underneath -->
        <Style Selector="Grid.Metric">
            <Setter Property="Margin" Value="0 0 0 12" />
        </Style>
        <Style Selector="Grid.Metric local|SegmentBar">
            <Setter Property="Margin" Value="0 6 0 0" />
        </Style>
        <Style Selector="Grid.Metric TextBlock.Unit">
            <Setter Property="Margin" Value="4 0 0 0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="StackPanel.ReadoutRow">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0 0 0 2" />
        </Style>

        <Style Selector="material|MaterialIcon.FanIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="0 0 6 0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Ink60Brush}" />
        </Style>

        <Style Selector="Rectangle.LegendKey">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Width" Value="40" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24 20 24 24" MaxWidth="1180"
              RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*,*">

            <!-- Page header -->
            <Grid Grid.Row="0" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" Margin="0 0 0 20">
                <StackPanel>
                    <TextBlock Text="DASHBOARD" Classes="PageTitle" />
                    <TextBlock Text="Live telemetry, thermal profile and fan control" Classes="PageCaption" />
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="Tag" Text="SEC_01 // MON · 2 s" VerticalAlignment="Bottom" />
            </Grid>

            <!-- ======================================================== CPU -->
            <local:HudPanel Classes="Card" Grid.Row="1" Grid.Column="0" Margin="0 0 8 16">
                <StackPanel>
                    <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                        <material:MaterialIcon Kind="Cpu64Bit" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="CpuTitle" Text="CPU" Classes="CardTitle" />
                            <TextBlock x:Name="CpuModel" Text="{Binding CpuName}" Classes="CardCaption"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding CpuName}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Classes="ReadoutRow">
                        <TextBlock x:Name="CpuTemperature" Classes="Readout" Classes.Hot="{Binding IsCpuHot}"
                                   Text="{Binding CpuTempText}" />
                        <TextBlock Classes="Unit" Text="°C" />
                    </StackPanel>
                    <TextBlock Classes="Label" Text="PACKAGE TEMP" Margin="0 0 0 16" />

                    <Grid Classes="Metric" ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock Classes="Label" Text="LOAD" />
                        <local:DotLeader Grid.Column="1" />
                        <TextBlock Grid.Column="2" Classes="Value" Text="{Binding CpuUsageText}" />
                        <TextBlock Grid.Column="3" Classes="Unit" Text="%" />
                        <local:SegmentBar Grid.Row="1" Grid.ColumnSpan="4" Maximum="100"
                                          Value="{Binding CpuUsage}" />
                    </Grid>

                    <Grid Classes="Metric" ColumnDefinitions="Auto,Auto,*,Auto,Auto" RowDefinitions="Auto,Auto"
                          Margin="0">
                        <material:MaterialIcon x:Name="CpuFanIcon" Classes="FanIcon" Kind="Fan" />
                        <TextBlock Grid.Column="1" Classes="Label" Text="FAN" />
                        <local:DotLeader Grid.Column="2" />
                        <TextBlock x:Name="CpuFanSpeed" Grid.Column="3" Classes="Value" Text="{Binding CpuFanText}" />
                        <TextBlock Grid.Column="4" Classes="Unit" Text="RPM" />
                        <local:SegmentBar Grid.Row="1" Grid.ColumnSpan="5" Maximum="6000"
                                          Value="{Binding CpuFanLevel}" />
                    </Grid>
                </StackPanel>
            </local:HudPanel>

            <!-- ======================================================== GPU -->
            <local:HudPanel Classes="Card" Grid.Row="1" Grid.Column="1" Margin="8 0 8 16">
                <StackPanel>
                    <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                        <material:MaterialIcon Kind="Gpu" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="GpuTitle" Text="GPU" Classes="CardTitle" />
                            <TextBlock x:Name="GpuModel" Text="{Binding GpuName}" Classes="CardCaption"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding GpuName}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Classes="ReadoutRow">
                        <TextBlock x:Name="GpuTemperature" Classes="Readout" Classes.Hot="{Binding IsGpuHot}"
                                   Text="{Binding GpuTempText}" />
                        <TextBlock Classes="Unit" Text="°C" IsVisible="{Binding !IsGpuAsleep}" />
                    </StackPanel>
                    <TextBlock Classes="Label" Text="{Binding GpuStateText}" Margin="0 0 0 16" />

                    <Grid Classes="Metric" ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock Classes="Label" Text="LOAD" />
                        <local:DotLeader Grid.Column="1" />
                        <TextBlock Grid.Column="2" Classes="Value" Text="{Binding GpuUsageText}" />
                        <TextBlock Grid.Column="3" Classes="Unit" Text="%" />
                        <local:SegmentBar Grid.Row="1" Grid.ColumnSpan="4" Maximum="100" Classes="Accent"
                                          Value="{Binding GpuUsage}" />
                    </Grid>

                    <Grid Classes="Metric" ColumnDefinitions="Auto,Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">
                        <material:MaterialIcon x:Name="GpuFanIcon" Classes="FanIcon" Kind="Fan" />
                        <TextBlock Grid.Column="1" Classes="Label" Text="FAN" />
                        <local:DotLeader Grid.Column="2" />
                        <TextBlock x:Name="GpuFanSpeed" Grid.Column="3" Classes="Value" Text="{Binding GpuFanText}" />
                        <TextBlock Grid.Column="4" Classes="Unit" Text="RPM" />
                        <local:SegmentBar Grid.Row="1" Grid.ColumnSpan="5" Maximum="6000"
                                          Value="{Binding GpuFanLevel}" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Classes="Label" Text="DRIVER" />
                        <local:DotLeader Grid.Column="1" />
                        <TextBlock x:Name="GpuDriver" Grid.Column="2" Classes="Value" Text="{Binding GpuDriverText}" />
                    </Grid>
                </StackPanel>
            </local:HudPanel>

            <!-- ======================================================== Battery -->
            <local:HudPanel Classes="Card" Grid.Row="1" Grid.Column="2" Margin="8 0 0 16"
                            IsVisible="{Binding HasBattery}">
                <StackPanel>
                    <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                        <material:MaterialIcon Kind="Battery70" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="BatteryTitle" Text="BATTERY" Classes="CardTitle" />
                            <TextBlock Text="Charge and power source" Classes="CardCaption" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Classes="ReadoutRow">
                        <TextBlock x:Name="BatteryPercentage" Classes="Readout" Text="{Binding BatteryPercentText}" />
                        <TextBlock Classes="Unit" Text="%" />
                    </StackPanel>
                    <TextBlock Classes="Label" Text="CHARGE" Margin="0 0 0 8" />
                    <local:SegmentBar x:Name="BatteryLevelBar" Maximum="100" Value="{Binding BatteryLevel}"
                                      Margin="0 0 0 16" />

                    <Grid Classes="KeyValue" ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Classes="Label" Text="STATE" />
                        <local:DotLeader Grid.Column="1" />
                        <TextBlock x:Name="PowerSource" Grid.Column="2" Classes="Value" Text="{Binding BatteryStatus}" />
                    </Grid>
                    <Grid Classes="KeyValue" ColumnDefinitions="Auto,*,Auto,Auto">
                        <TextBlock Classes="Label" Text="REMAINING" />
                        <local:DotLeader Grid.Column="1" />
                        <TextBlock x:Name="BatteryTimeRemaining" Grid.Column="2" Classes="Value"
                                   Text="{Binding BatteryTimeRemainingString}" />
                        <TextBlock Grid.Column="3" Classes="Unit" Text="H:MM" Margin="6 0 0 0"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid Classes="KeyValue" ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Classes="Label" Text="LIMITER" />
                        <local:DotLeader Grid.Column="1" />
                        <TextBlock Grid.Column="2" Classes="Value" Text="{Binding BatteryLimiterText}" />
                    </Grid>
                </StackPanel>
            </local:HudPanel>

            <!-- ======================================================== Thermal profile -->
            <local:HudPanel x:Name="ThermalProfilePanel" Classes="Card" Grid.Row="2" Grid.Column="0"
                            Grid.ColumnSpan="3" Margin="0 0 0 16">
                <StackPanel>
                    <Grid Classes="CardHeader" ColumnDefinitions="Auto,*,Auto">
                        <material:MaterialIcon Kind="Speedometer" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="THERMAL PROFILE" Classes="CardTitle" />
                            <TextBlock Classes="CardCaption"
                                       Text="Profiles offered by the firmware (platform_profile_choices)" />
                        </StackPanel>
                        <!-- Power source indicator, driven by PowerSourceDetection (read-only) -->
                        <ToggleSwitch x:Name="PluggedInToggleSwitch" Grid.Column="2" VerticalAlignment="Center"
                                      IsChecked="True" IsHitTestVisible="False" Focusable="False"
                                      OnContent="AC POWER" OffContent="BATTERY"
                                      FontFamily="{StaticResource MonoFont}" FontSize="11" />
                    </Grid>

                    <!-- Segments are created at runtime from the daemon's reported choices -->
                    <UniformGrid x:Name="ProfileButtonsPanel" Rows="1" />

                    <TextBlock x:Name="ThermalProfileInfoText" Classes="Hint" Margin="0 12 0 0"
                               Text="Waiting for the daemon to report the available profiles." />
                </StackPanel>
            </local:HudPanel>

            <!-- ======================================================== Fan control -->
            <local:HudPanel x:Name="FanControlPanel" Classes="Card" Grid.Row="3" Grid.Column="0"
                            Margin="0 0 8 16" VerticalAlignment="Stretch">
                <StackPanel>
                    <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                        <material:MaterialIcon Kind="Fan" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="FAN CONTROL" Classes="CardTitle" />
                            <TextBlock Text="CPU + GPU fan mode" Classes="CardCaption" />
                        </StackPanel>
                    </Grid>

                    <UniformGrid Rows="1">
                        <RadioButton x:Name="AutoFanSpeedRadioButton" GroupName="FanModeGroup" IsChecked="True"
                                     Theme="{StaticResource SegmentRadio}" Margin="0 0 6 0" Padding="8 8" Content="AUTO" />
                        <RadioButton x:Name="MaxFanSpeedRadioButton" GroupName="FanModeGroup"
                                     Theme="{StaticResource SegmentRadio}" Margin="0 0 6 0" Padding="8 8" Content="MAX" />
                        <RadioButton x:Name="ManualFanSpeedRadioButton" GroupName="FanModeGroup"
                                     Theme="{StaticResource SegmentRadio}" Padding="8 8" Content="MANUAL" />
                    </UniformGrid>

                    <TextBlock x:Name="ManualDisabledInfoText" Classes="Hint" Margin="0 12 0 0" IsVisible="False"
                               Text="Manual and max fan modes are disabled in the quiet profile." />

                    <StackPanel Margin="0 16 0 0" Spacing="8"
                                IsVisible="{Binding ElementName=ManualFanSpeedRadioButton, Path=IsChecked}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Text="CPU" Classes="FieldLabel" />
                            <Slider x:Name="CpuFanSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    TickFrequency="5" IsSnapToTickEnabled="True" Value="50" />
                            <local:HudPanel Grid.Column="2" Classes="Readout">
                                <TextBlock x:Name="CpuFanTextBlock" Text="50%" />
                            </local:HudPanel>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Text="GPU" Classes="FieldLabel" />
                            <Slider x:Name="GpuFanSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    TickFrequency="5" IsSnapToTickEnabled="True" Value="70" />
                            <local:HudPanel Grid.Column="2" Classes="Readout">
                                <TextBlock x:Name="GpuFanTextBlock" Text="70%" />
                            </local:HudPanel>
                        </Grid>
                        <Button x:Name="SetManualSpeedButton" Content="APPLY FAN SPEEDS" Classes="Primary"
                                HorizontalAlignment="Stretch" Margin="0 4 0 0" />
                        <TextBlock Classes="Hint" Text="Low fan speeds raise temperatures. 0 % = automatic." />
                    </StackPanel>
                </StackPanel>
            </local:HudPanel>

            <!-- ======================================================== Temperature history -->
            <local:HudPanel Classes="Card" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="8 0 0 16">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Classes="CardHeader" ColumnDefinitions="Auto,*,Auto">
                        <material:MaterialIcon Kind="ChartLine" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="TemperatureMonitorTitle" Text="TEMPERATURE HISTORY"
                                       Classes="CardTitle" />
                            <TextBlock Text="Last 2 minutes" Classes="CardCaption" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Classes="LegendKey" Fill="{StaticResource InkBrush}" />
                                <TextBlock Text="CPU" Classes="Tag" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Classes="LegendKey" Fill="{StaticResource AccentBrush}" />
                                <TextBlock Text="GPU" Classes="Tag" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <avalonia:CartesianChart x:Name="TemperatureChart" VerticalAlignment="Stretch" MinHeight="220" />
                </DockPanel>
            </local:HudPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
