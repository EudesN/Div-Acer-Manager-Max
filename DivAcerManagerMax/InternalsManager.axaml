<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:material="using:Material.Icons.Avalonia"
        xmlns:local="using:DivAcerManagerMax"
        x:Class="DivAcerManagerMax.InternalsManager"
        Width="680" Height="720" MinWidth="560" MinHeight="480"
        Title="DAMX // Internals"
        Icon="iconTransparent.png"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">

    <Window.Styles>
        <Style Selector="TextBlock.Bullet">
            <Setter Property="Margin" Value="0 2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
        </Style>
        <Style Selector="local|HudPanel.Card">
            <Setter Property="Margin" Value="0 0 0 16" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- Header strip -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0 0 0 1">
            <Panel>
                <Grid ColumnDefinitions="*,Auto" Margin="24 14">
                    <StackPanel>
                        <TextBlock Text="INTERNALS" Classes="PageTitle" />
                        <TextBlock Text="Root actions: driver parameters and restarts" Classes="PageCaption" />
                    </StackPanel>
                </Grid>
            </Panel>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24 20 24 20">

                <!-- Status line (non-blocking feedback for every action) -->
                <TextBlock x:Name="InternalsStatusText" Classes="Hint" Margin="0 0 0 16"
                           Text="Ready." TextWrapping="Wrap" />

                <!-- Developer Mode -->
                <local:HudPanel Classes="Card">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="DEVELOPER MODE" Classes="CardTitle" />
                            <TextBlock Text="Show every control, even for features the daemon did not report"
                                       Classes="CardCaption" />
                        </StackPanel>
                        <ToggleSwitch x:Name="DevModeToggleSwitch" Grid.Column="2"
                                      VerticalAlignment="Center" OnContent="" OffContent=""
                                      Click="DevModeSwitch_OnClick" />
                    </Grid>
                </local:HudPanel>

                <!-- Driver Parameters -->
                <local:HudPanel Classes="Card">
                    <StackPanel>
                        <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="DRIVER PARAMETERS" Classes="CardTitle" />
                                <TextBlock Text="Reload linuwu_sense with a parameter (until next reboot)"
                                           Classes="CardCaption" />
                            </StackPanel>
                        </Grid>

                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="ForceNitroButton" Content="LOAD nitro_v4" Classes="Spaced"
                                    Click="ForceNitroButton_OnClick" />
                            <Button x:Name="ForcePredatorButton" Content="LOAD predator_v4" Classes="Spaced"
                                    Click="ForcePredatorButton_OnClick" />
                            <Button x:Name="ForceEnableAll" Content="LOAD enable_all" Classes="Spaced"
                                    Click="ForceEnableAll_OnClick" />
                        </WrapPanel>

                        <TextBlock Classes="Bullet" Margin="0 4 0 0"
                                   Text="Parameters are cleared after a reboot unless a permanent override is set below." />
                    </StackPanel>
                </local:HudPanel>

                <!-- Permanent Model Override -->
                <local:HudPanel Classes="Card">
                    <StackPanel>
                        <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="PERMANENT MODEL OVERRIDE" Classes="CardTitle" />
                                <TextBlock Classes="CardCaption"
                                           Text="Force a model for unsupported or problematic devices (/etc/modprobe.d)" />
                            </StackPanel>
                        </Grid>

                        <ComboBox x:Name="ForceParameterPermanentlyComboBox"
                                  SelectedIndex="0"
                                  SelectionChanged="ForceParameterPermanently_OnSelectionChanged"
                                  HorizontalAlignment="Stretch"
                                  MaxWidth="420">
                            <ComboBoxItem Content="Disabled" />
                            <ComboBoxItem Content="Force Predator Model (predator_v4)" />
                            <ComboBoxItem Content="Force Nitro Model (nitro_v4)" />
                            <ComboBoxItem Content="Force Enable All Features (enable_all)" />
                        </ComboBox>
                        <TextBlock Classes="Bullet" Margin="0 8 0 0"
                                   Text="The value shown is read back from the daemon after every change." />
                    </StackPanel>
                </local:HudPanel>

                <!-- System Restart Controls -->
                <local:HudPanel Classes="Card">
                    <StackPanel>
                        <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="RESTART" Classes="CardTitle" />
                                <TextBlock Text="Restart components to apply changes" Classes="CardCaption" />
                            </StackPanel>
                        </Grid>

                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="RestartSuiteButton" Content="RESTART DRIVERS + DAEMON"
                                    Classes="Spaced Danger" Click="RestartSuiteButton_OnClick" />
                            <Button x:Name="RestartDaemon" Content="RESTART DAEMON ONLY" Classes="Spaced"
                                    Click="RestartDaemon_OnClick" />
                        </WrapPanel>

                        <StackPanel Margin="0 4 0 0">
                            <TextBlock Classes="Bullet" Text="Drivers + daemon: full reset, clears runtime parameters." />
                            <TextBlock Classes="Bullet" Text="Daemon only: re-detects features with the current parameters." />
                        </StackPanel>
                    </StackPanel>
                </local:HudPanel>

                <!-- Debug Tools -->
                <local:HudPanel Classes="Card">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="DEBUG" Classes="CardTitle" />
                            <TextBlock Text="/var/log/DAMX_Daemon_Log.log" Classes="CardCaption" />
                        </StackPanel>
                        <Button x:Name="DaemonLogsButton" Grid.Column="2" Content="VIEW LOGS"
                                VerticalAlignment="Center" Click="DaemonLogsButton_OnClick" />
                    </Grid>
                </local:HudPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
