<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:material="using:Material.Icons.Avalonia"
        xmlns:local="using:DivAcerManagerMax"
        x:Class="DivAcerManagerMax.InternalsManager"
        Width="640" Height="740"
        Title="DAMX Internals Manager"
        Icon="iconTransparent.png"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">

    <Window.Styles>
        <Style Selector="TextBlock.Bullet">
            <Setter Property="Margin" Value="0 3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>
        <Style Selector="Border.Card">
            <Setter Property="Margin" Value="0 0 0 16" />
        </Style>
    </Window.Styles>

    <Grid>
        <ScrollViewer>
            <StackPanel Margin="28 26 28 20">

                <!-- Header -->
                <Grid Classes="PageHeader" ColumnDefinitions="*,Auto" Margin="0 0 0 20">
                    <StackPanel>
                        <TextBlock Text="INTERNALS" Classes="SectionHeader" FontSize="26" />
                        <TextBlock Text="&gt; ADVANCED DRIVER AND DAEMON CONTROLS" Classes="Caption" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="6">
                        <TextBlock Text="ROOT // DEV" Classes="Tag" HorizontalAlignment="Right" />
                        <local:Stripes Width="110" Height="10" Fill="#66FFC857" />
                    </StackPanel>
                </Grid>

                <!-- Developer Mode -->
                <Border Classes="Card">
                    <local:HudPanel Classes="Card">
                        <Grid Classes="CardHeader" ColumnDefinitions="Auto,*,Auto" Margin="0">
                            <Border Classes="IconBadge">
                                <material:MaterialIcon Kind="CodeBraces" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="DEVELOPER MODE" Classes="SubHeader" />
                                <TextBlock Text="// enable advanced controls and feature overrides"
                                           Classes="Caption" />
                            </StackPanel>
                            <ToggleSwitch x:Name="DevModeToggleSwitch" Grid.Column="2"
                                          VerticalAlignment="Center" OnContent="" OffContent=""
                                          Click="DevModeSwitch_OnClick" />
                        </Grid>
                    </local:HudPanel>
                </Border>

                <!-- Driver Parameters -->
                <Border Classes="Card">
                    <local:HudPanel Classes="Card">
                        <StackPanel>
                            <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                                <Border Classes="IconBadge">
                                    <material:MaterialIcon Kind="Chip" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="DRIVER PARAMETERS" Classes="SubHeader" />
                                    <TextBlock Text="// load drivers with specific parameters (one-time only)"
                                               Classes="Caption" />
                                </StackPanel>
                            </Grid>
                            <Border Classes="Rule" />

                            <WrapPanel ItemSpacing="10" LineSpacing="10">
                                <Button x:Name="ForceNitroButton"
                                        Content="LOAD nitro__v4"
                                        Classes="Secondary"
                                        Click="ForceNitroButton_OnClick" />
                                <Button x:Name="ForcePredatorButton"
                                        Content="LOAD predator__v4"
                                        Classes="Secondary"
                                        Click="ForcePredatorButton_OnClick" />
                                <Button x:Name="ForceEnableAll"
                                        Content="LOAD enable__all"
                                        Classes="Secondary"
                                        Click="ForceEnableAll_OnClick" />
                            </WrapPanel>

                            <TextBlock Text="&gt; parameters are cleared after restart unless permanent forcing is enabled"
                                       Classes="Bullet" TextWrapping="Wrap" Margin="0 10 0 0" />
                        </StackPanel>
                    </local:HudPanel>
                </Border>

                <!-- Permanent Model Override -->
                <Border Classes="Card">
                    <local:HudPanel Classes="Card">
                        <StackPanel>
                            <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                                <Border Classes="IconBadge Warning">
                                    <material:MaterialIcon Kind="Pin" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="PERMANENT MODEL OVERRIDE" Classes="SubHeader" />
                                    <TextBlock Classes="Caption"
                                               Text="// force a specific model for unsupported or problematic devices" />
                                </StackPanel>
                            </Grid>
                            <Border Classes="Rule" />

                            <ComboBox x:Name="ForceParameterPermanentlyComboBox"
                                      SelectedIndex="0"
                                      SelectionChanged="ForceParameterPermanently_OnSelectionChanged"
                                      HorizontalAlignment="Left"
                                      MinWidth="340">
                                <ComboBoxItem Content="Disabled" />
                                <ComboBoxItem Content="Force Predator Model (predator_v4)" />
                                <ComboBoxItem Content="Force Nitro Model (nitro_v4)" />
                                <ComboBoxItem Content="Force Enable All Features (enable_all)" />
                            </ComboBox>
                        </StackPanel>
                    </local:HudPanel>
                </Border>

                <!-- System Restart Controls -->
                <Border Classes="Card">
                    <local:HudPanel Classes="Card">
                        <StackPanel>
                            <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                                <Border Classes="IconBadge">
                                    <material:MaterialIcon Kind="Restart" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="SYSTEM RESTART CONTROLS" Classes="SubHeader" />
                                    <TextBlock Text="// restart system components to apply changes"
                                               Classes="Caption" />
                                </StackPanel>
                            </Grid>
                            <Border Classes="Rule" />

                            <WrapPanel ItemSpacing="10" LineSpacing="10">
                                <Button x:Name="RestartSuiteButton"
                                        Content="RESTART DRIVERS + DAEMON"
                                        Click="RestartSuiteButton_OnClick" />
                                <Button x:Name="RestartDaemon"
                                        Content="RESTART DAEMON ONLY"
                                        Classes="Secondary"
                                        Click="RestartDaemon_OnClick" />
                            </WrapPanel>

                            <StackPanel Margin="0 10 0 0">
                                <TextBlock Text="&gt; restart both: full reset, clears all parameters"
                                           Classes="Bullet" />
                                <TextBlock Text="&gt; restart daemon: updates feature set with current parameters"
                                           Classes="Bullet" />
                            </StackPanel>
                        </StackPanel>
                    </local:HudPanel>
                </Border>

                <!-- Debug Tools -->
                <Border Classes="Card">
                    <local:HudPanel Classes="Card">
                        <Grid Classes="CardHeader" ColumnDefinitions="Auto,*,Auto" Margin="0">
                            <Border Classes="IconBadge">
                                <material:MaterialIcon Kind="Bug" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="DEBUG TOOLS" Classes="SubHeader" />
                                <TextBlock Text="// access diagnostic information and logs" Classes="Caption" />
                            </StackPanel>
                            <Button x:Name="DaemonLogsButton" Grid.Column="2"
                                    Content="VIEW LOGS"
                                    Classes="Secondary"
                                    VerticalAlignment="Center"
                                    Click="DaemonLogsButton_OnClick" />
                        </Grid>
                    </local:HudPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <local:Scanlines Fill="{StaticResource ScanlineBrush}" Pitch="3" />
    </Grid>

</Window>
