<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:DivAcerManagerMax"
        xmlns:local="using:DivAcerManagerMax"
        xmlns:material="using:Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"

        x:Class="DivAcerManagerMax.MainWindow"
        Title="DAMX"
        Icon="iconTransparent.png"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="Full"
        Background="{StaticResource AppBackgroundBrush}"

        Width="1200" Height="760"
        MinWidth="1100" MinHeight="560">

    <Window.Styles>
        <!-- The tab strip sits on top of the sidebar panel drawn behind the TabControl. -->
        <Style Selector="TabControl.Sidebar /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="Width" Value="216" />
            <Setter Property="Margin" Value="16 146 16 12" />
        </Style>

        <!-- Page content area to the right of the sidebar -->
        <Style Selector="TabControl.Sidebar ScrollViewer.Page > StackPanel">
            <Setter Property="Margin" Value="36 30 36 24" />
            <Setter Property="MaxWidth" Value="1040" />
        </Style>

        <Style Selector="local|HudPanel.Tile TextBlock">
            <Setter Property="Margin" Value="0 0 0 10" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>

        <!-- "KEY ........ VALUE" rows -->
        <Style Selector="Grid.KeyValue">
            <Setter Property="Margin" Value="0 5" />
        </Style>
        <Style Selector="Grid.KeyValue TextBlock">
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.KeyValue TextBlock.Key">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LetterSpacing" Value="1" />
        </Style>
        <Style Selector="Grid.KeyValue TextBlock.Value">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <!-- Small boxed readout showing a slider's value -->
        <Style Selector="local|HudPanel.Readout">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentDimBrush}" />
            <Setter Property="Cut" Value="5" />
            <Setter Property="CutBottomLeft" Value="False" />
            <Setter Property="Padding" Value="8 3" />
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="Margin" Value="14 0 0 0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="local|HudPanel.Readout TextBlock">
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Width" Value="104" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>

        <Style Selector="TextBlock.Hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>
    </Window.Styles>

    <Grid>

        <Grid ColumnDefinitions="248,*">

            <!-- Sidebar panel (the navigation items are the TabControl's strip, laid over it) -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0 0 1 0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Margin="20 24 20 0">
                        <Grid ColumnDefinitions="Auto,*">
                            <local:HudPanel Width="46" Height="46" Cut="9" CutTopLeft="False"
                                            Background="{StaticResource AccentSoftBrush}"
                                            BorderBrush="{StaticResource AccentDimBrush}">
                                <Image Source="iconTransparent.png" Margin="6" />
                            </local:HudPanel>
                            <StackPanel Grid.Column="1" Margin="12 0 0 0" VerticalAlignment="Center">
                                <TextBlock Text="DAMX" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                                           FontSize="28" LetterSpacing="6" Margin="0"
                                           Foreground="{StaticResource AccentBrush}">
                                    <TextBlock.Effect>
                                        <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="14"
                                                          Color="#9EF0C5" Opacity="0.55" />
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text="DIV.ACER.MANAGER.MAX" Classes="Tag" />
                            </StackPanel>
                        </Grid>
                        <local:Stripes Height="6" Margin="0 18 0 0" StripeWidth="3" Gap="3" />
                        <TextBlock Text="// NAVIGATION" Classes="Tag" Margin="2 18 0 0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="20 0 20 20">
                        <Border Classes="Rule" Margin="0 0 0 10" />
                        <TextBlock Text="&gt; ACER_WMI // CONTROL" Classes="Tag" Margin="0 0 0 4" />
                        <TextBlock Text="&gt; NITRO // PREDATOR" Classes="Tag" />
                        <local:Stripes Height="4" Margin="0 12 0 0" StripeWidth="2" Gap="4" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <TabControl Grid.Column="0" Grid.ColumnSpan="2" Classes="Sidebar" TabStripPlacement="Left"
                        Background="Transparent" BorderThickness="0" Padding="0">
                <TabControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="2" />
                    </ItemsPanelTemplate>
                </TabControl.ItemsPanel>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Classes="NavHeader" Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="01" Classes="NavIndex" />
                            <TextBlock Text="DASHBOARD" />
                        </StackPanel>
                    </TabItem.Header>

                    <views:Dashboard />

                </TabItem>

                <!-- Power & Performance Tab -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Classes="NavHeader" Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="02" Classes="NavIndex" />
                            <TextBlock Text="POWER &amp; PERF" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer Classes="Page">
                        <StackPanel>
                            <Grid Classes="PageHeader" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="POWER // PERFORMANCE" Classes="SectionHeader" />
                                    <TextBlock Text="&gt; THERMAL PROFILES AND FAN BEHAVIOUR" Classes="Caption" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="6">
                                    <TextBlock Text="SEC_02 // PWR" Classes="Tag" HorizontalAlignment="Right" />
                                    <local:Stripes Width="140" Height="10" />
                                </StackPanel>
                            </Grid>

                            <Border Classes="Card" x:Name="ThermalProfilePanel">
                                <local:HudPanel Classes="Card">
                                    <StackPanel>
                                        <Grid Classes="CardHeader" ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="IconBadge">
                                                <material:MaterialIcon Kind="Speedometer" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="PERFORMANCE PROFILES" Classes="SubHeader" />
                                                <TextBlock Classes="Caption"
                                                           Text="// configure thermal profiles to balance performance and temperature" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="PluggedInToggleSwitch" Grid.Column="2"
                                                          VerticalAlignment="Center" IsChecked="True"
                                                          IsHitTestVisible="False">
                                                <ToggleSwitch.OffContent>
                                                    <material:MaterialIcon Kind="BatteryOutline" Width="20" Height="20" />
                                                </ToggleSwitch.OffContent>
                                                <ToggleSwitch.OnContent>
                                                    <material:MaterialIcon Kind="PowerPlugOutline" Width="20" Height="20" />
                                                </ToggleSwitch.OnContent>
                                            </ToggleSwitch>
                                        </Grid>
                                        <Border Classes="Rule" />

                                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                            <RadioButton x:Name="LowPowerProfileButton" GroupName="ProfileGroup"
                                                         IsVisible="{Binding ElementName=PluggedInToggleSwitch, Path=!IsChecked}">
                                                <StackPanel>
                                                    <material:MaterialIcon Kind="Leaf" />
                                                    <TextBlock Text="ECO" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </RadioButton>

                                            <RadioButton x:Name="QuietProfileButton" GroupName="ProfileGroup"
                                                         IsVisible="{Binding ElementName=PluggedInToggleSwitch, Path=IsChecked}">
                                                <StackPanel>
                                                    <material:MaterialIcon Kind="FanMinus" />
                                                    <TextBlock Text="QUIET" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </RadioButton>

                                            <RadioButton x:Name="BalancedProfileButton" GroupName="ProfileGroup"
                                                         IsChecked="True">
                                                <StackPanel>
                                                    <material:MaterialIcon Kind="ScaleBalance" />
                                                    <TextBlock Text="BALANCED" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </RadioButton>

                                            <RadioButton x:Name="PerformanceProfileButton" GroupName="ProfileGroup"
                                                         IsVisible="{Binding ElementName=PluggedInToggleSwitch, Path=IsChecked}">
                                                <StackPanel>
                                                    <material:MaterialIcon Kind="SpeedometerMedium" />
                                                    <TextBlock Text="PERFORMANCE" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </RadioButton>

                                            <RadioButton x:Name="TurboProfileButton" GroupName="ProfileGroup"
                                                         IsVisible="{Binding ElementName=PluggedInToggleSwitch, Path=IsChecked}">
                                                <StackPanel>
                                                    <material:MaterialIcon Kind="RocketLaunch" />
                                                    <TextBlock Text="TURBO" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </RadioButton>
                                        </StackPanel>

                                        <TextBlock x:Name="ThermalProfileInfoText" Classes="Hint"
                                                   Margin="0 18 0 0"
                                                   Text="Performance profiles are preset modes that control your device's speed, power use, and cooling:"
                                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </local:HudPanel>
                            </Border>

                            <!-- Fan Speed Control -->
                            <Border Classes="Card" x:Name="FanControlPanel">
                                <local:HudPanel Classes="Card">
                                    <StackPanel>
                                        <Grid Classes="CardHeader" ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="IconBadge">
                                                <material:MaterialIcon Kind="Fan" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="FAN SPEED CONTROL" Classes="SubHeader" />
                                                <TextBlock Text="// set custom fan speeds for cpu and gpu"
                                                           Classes="Caption" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="[FAN.CTL]" Classes="Tag"
                                                       VerticalAlignment="Top" />
                                        </Grid>
                                        <Border Classes="Rule" />

                                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                            <RadioButton x:Name="AutoFanSpeedRadioButton" GroupName="FanModeGroup"
                                                         IsChecked="True">
                                                <StackPanel>
                                                    <material:MaterialIcon Kind="AutoAwesome" />
                                                    <TextBlock Text="AUTO" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </RadioButton>

                                            <RadioButton x:Name="MaxFanSpeedRadioButton" GroupName="FanModeGroup"
                                                         Click="MaxFanSpeedRadioButton_OnClick">
                                                <StackPanel>
                                                    <material:MaterialIcon Kind="Turbine" />
                                                    <TextBlock Text="MAX" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </RadioButton>

                                            <RadioButton x:Name="ManualFanSpeedRadioButton" GroupName="FanModeGroup">
                                                <StackPanel>
                                                    <material:MaterialIcon Kind="TuneVariant" />
                                                    <TextBlock Text="MANUAL" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </RadioButton>
                                        </StackPanel>

                                        <TextBlock x:Name="ManualDisabledInfoText" Classes="Hint"
                                                   Text="&gt; manual fan controls are disabled to ensure quiet operation"
                                                   HorizontalAlignment="Center" Margin="0 18 0 0"
                                                   IsVisible="{Binding ElementName=QuietProfileButton, Path=IsChecked}" />

                                        <StackPanel Margin="0 22 0 0"
                                                    IsVisible="{Binding ElementName=ManualFanSpeedRadioButton , Path=IsChecked}">

                                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU_FAN"
                                                           Classes="FieldLabel" />
                                                <Slider x:Name="CpuFanSlider" Grid.Row="0" Grid.Column="1" Value="50" />
                                                <local:HudPanel Grid.Row="0" Grid.Column="2" Classes="Readout">
                                                    <TextBlock x:Name="CpuFanTextBlock" Text="50%" />
                                                </local:HudPanel>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="GPU_FAN"
                                                           Classes="FieldLabel" />
                                                <Slider x:Name="GpuFanSlider" Grid.Row="1" Grid.Column="1" Value="70" />
                                                <local:HudPanel Grid.Row="1" Grid.Column="2" Classes="Readout">
                                                    <TextBlock x:Name="GpuFanTextBlock" Text="70%" />
                                                </local:HudPanel>
                                            </Grid>

                                            <Grid ColumnDefinitions="Auto,*" Margin="0 14 0 0">
                                                <Button x:Name="SetManualSpeedButton" Content="APPLY FAN SETTINGS"
                                                        Click="SetManualSpeedButton_OnClick" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <material:MaterialIcon Kind="AlertOutline" Width="15" Height="15"
                                                                           Foreground="{StaticResource WarningBrush}" />
                                                    <TextBlock Text="LOW FAN SPEEDS MAY RESULT IN HIGHER TEMPERATURES"
                                                               Classes="Caption Warning" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </local:HudPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Power Controls Tab -->
                <TabItem x:Name="BatteryPanel">
                    <TabItem.Header>
                        <StackPanel Classes="NavHeader" Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="03" Classes="NavIndex" />
                            <TextBlock Text="BATTERY" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer Classes="Page">
                        <StackPanel>
                            <Grid Classes="PageHeader" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="POWER CONTROLS" Classes="SectionHeader" />
                                    <TextBlock Text="&gt; BATTERY HEALTH AND USB CHARGING" Classes="Caption" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="6">
                                    <TextBlock Text="SEC_03 // BAT" Classes="Tag" HorizontalAlignment="Right" />
                                    <local:Stripes Width="140" Height="10" />
                                </StackPanel>
                            </Grid>

                            <!-- Battery Calibration -->
                            <Border Classes="Card" x:Name="CalibrationControls">
                                <local:HudPanel Classes="Card">
                                    <StackPanel>
                                        <Grid Classes="CardHeader" ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="IconBadge">
                                                <material:MaterialIcon Kind="BatterySync" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="BATTERY CALIBRATION" Classes="SubHeader" />
                                                <TextBlock Classes="Caption"
                                                           Text="// calibrate your battery to get accurate percentage readings" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="[CAL]" Classes="Tag"
                                                       VerticalAlignment="Top" />
                                        </Grid>
                                        <Border Classes="Rule" />

                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock x:Name="CalibrationStatusTextBlock" Margin="0"
                                                           Text="Status: Not calibrating" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock
                                                    Text="&gt; full charge, drain and recharge cycle"
                                                    TextWrapping="Wrap" Margin="0 6 0 0" Classes="Hint" />
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0 6 0 0">
                                                    <material:MaterialIcon Kind="AlertOutline" Width="15" Height="15"
                                                                           Foreground="{StaticResource WarningBrush}" />
                                                    <TextBlock Text="DO NOT UNPLUG AC POWER DURING CALIBRATION"
                                                               Classes="Caption Warning" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                                        VerticalAlignment="Center" Margin="20 0 0 0">
                                                <Button x:Name="StopCalibrationButton" Content="STOP"
                                                        Classes="Secondary" IsEnabled="False" />
                                                <Button x:Name="StartCalibrationButton" Content="START CALIBRATION" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </local:HudPanel>
                            </Border>

                            <!-- Charge Limit -->
                            <Border Classes="Card" x:Name="LimiterControls">
                                <local:HudPanel Classes="Card">
                                    <StackPanel>
                                        <Grid Classes="CardHeader" ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="IconBadge">
                                                <material:MaterialIcon Kind="BatteryHeartVariant" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="BATTERY CHARGE LIMIT" Classes="SubHeader" />
                                                <TextBlock Classes="Caption"
                                                           Text="// limit maximum charge to 80% to extend battery lifespan" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="[LIM.80]" Classes="Tag"
                                                       VerticalAlignment="Top" />
                                        </Grid>
                                        <Border Classes="Rule" />

                                        <CheckBox x:Name="BatteryLimitCheckBox" Content="ENABLE BATTERY LIMIT (80%)" />

                                        <TextBlock Text="&gt; recommended for laptops that are frequently connected to AC power"
                                                   Classes="Hint" TextWrapping="Wrap" Margin="0 8 0 0" />
                                    </StackPanel>
                                </local:HudPanel>
                            </Border>

                            <!-- USB Power Delivery -->
                            <Border Classes="Card" x:Name="UsbChargingPanel">
                                <local:HudPanel Classes="Card">
                                    <StackPanel>
                                        <Grid Classes="CardHeader" ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="IconBadge">
                                                <material:MaterialIcon Kind="UsbPort" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="USB POWER DELIVERY" Classes="SubHeader" />
                                                <TextBlock Text="// usb charging while the laptop is powered off"
                                                           Classes="Caption" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="[USB.PD]" Classes="Tag"
                                                       VerticalAlignment="Top" />
                                        </Grid>
                                        <Border Classes="Rule" />

                                        <ComboBox x:Name="UsbChargingComboBox" SelectedIndex="2" Width="320"
                                                  HorizontalAlignment="Left"
                                                  SelectionChanged="UsbChargingComboBox_OnSelectionChanged">
                                            <ComboBoxItem Content="Disabled" />
                                            <ComboBoxItem Content="Until battery reaches 10%" />
                                            <ComboBoxItem Content="Until battery reaches 20%" />
                                            <ComboBoxItem Content="Until battery reaches 30%" />
                                        </ComboBox>
                                    </StackPanel>
                                </local:HudPanel>
                            </Border>
                        </StackPanel>

                    </ScrollViewer>
                </TabItem>

                <!-- Keyboard Lighting Tab -->
                <TabItem x:Name="KeyboardLightingPanel">
                    <TabItem.Header>
                        <StackPanel Classes="NavHeader" Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="04" Classes="NavIndex" />
                            <TextBlock Text="KEYBOARD RGB" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer Classes="Page">
                        <StackPanel>
                            <Grid Classes="PageHeader" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="KEYBOARD LIGHTING" Classes="SectionHeader" />
                                    <TextBlock Text="&gt; ZONE COLOURS, EFFECTS AND BACKLIGHT" Classes="Caption" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="6">
                                    <TextBlock Text="SEC_04 // RGB" Classes="Tag" HorizontalAlignment="Right" />
                                    <local:Stripes Width="140" Height="10" />
                                </StackPanel>
                            </Grid>

                            <local:HudPanel Classes="Notice">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <material:MaterialIcon Kind="FlaskOutline" Width="15" Height="15" />
                                    <TextBlock Text="WARNING // THIS SECTION REQUIRES TESTING" />
                                </StackPanel>
                            </local:HudPanel>

                            <!-- Zone Color Control -->
                            <Border Classes="Card" x:Name="ZoneColorControlPanel">
                                <local:HudPanel Classes="Card">
                                    <StackPanel>
                                        <Grid Classes="CardHeader" ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="IconBadge">
                                                <material:MaterialIcon Kind="Palette" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="ZONE COLOR CONTROL" Classes="SubHeader" />
                                                <TextBlock Text="// customize colors for each keyboard zone"
                                                           Classes="Caption" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="[ZONES:4]" Classes="Tag"
                                                       VerticalAlignment="Top" />
                                        </Grid>
                                        <Border Classes="Rule" />

                                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                                            <!-- Zone 1 -->
                                            <local:HudPanel Grid.Column="0" Classes="Tile">
                                                <StackPanel>
                                                    <TextBlock Text="ZONE_01" />
                                                    <Border x:Name="Zone1Border" Background="#4287f5" Height="30"
                                                            IsVisible="False" />
                                                    <ColorPicker x:Name="Zone1ColorPicker"
                                                                 IsAlphaEnabled="False"
                                                                 IsAlphaVisible="False"
                                                                 Color="#4287f5"
                                                                 HorizontalAlignment="Left"
                                                                 Height="40"
                                                                 Width="160" />
                                                </StackPanel>
                                            </local:HudPanel>

                                            <!-- Zone 2 -->
                                            <local:HudPanel Grid.Column="1" Classes="Tile">
                                                <StackPanel>
                                                    <TextBlock Text="ZONE_02" />
                                                    <Border x:Name="Zone2Border" Background="#ff5733" Height="30"
                                                            IsVisible="False" />
                                                    <ColorPicker x:Name="Zone2ColorPicker"
                                                                 IsAlphaEnabled="False"
                                                                 HexInputAlphaPosition="Trailing"
                                                                 Color="#ff5733"
                                                                 HorizontalAlignment="Left"
                                                                 Height="40"
                                                                 Width="160" />
                                                </StackPanel>
                                            </local:HudPanel>

                                            <!-- Zone 3 -->
                                            <local:HudPanel Grid.Column="2" Classes="Tile">
                                                <StackPanel>
                                                    <TextBlock Text="ZONE_03" />
                                                    <Border x:Name="Zone3Border" Background="#33ff57" Height="30"
                                                            IsVisible="False" />
                                                    <ColorPicker x:Name="Zone3ColorPicker"
                                                                 IsAlphaEnabled="False"
                                                                 HexInputAlphaPosition="Trailing"
                                                                 Color="#33ff57"
                                                                 HorizontalAlignment="Left"
                                                                 Height="40"
                                                                 Width="160" />
                                                </StackPanel>
                                            </local:HudPanel>

                                            <!-- Zone 4 -->
                                            <local:HudPanel Grid.Column="3" Classes="Tile">
                                                <StackPanel>
                                                    <TextBlock Text="ZONE_04" />
                                                    <ColorPicker x:Name="Zone4ColorPicker"
                                                                 IsAlphaEnabled="False"
                                                                 HexInputAlphaPosition="Trailing"
                                                                 Color="#FFFF01"
                                                                 HorizontalAlignment="Left"
                                                                 Height="40"
                                                                 Width="160" />
                                                </StackPanel>
                                            </local:HudPanel>
                                        </Grid>

                                        <!-- Brightness -->
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0 16 0 0">
                                            <TextBlock Grid.Column="0" Text="BRIGHTNESS" Classes="FieldLabel" />
                                            <Slider x:Name="KeyBrightnessSlider" Grid.Column="1" Value="100" />
                                            <local:HudPanel Grid.Column="2" Classes="Readout">
                                                <TextBlock x:Name="KeyBrightnessText" Text="100%" />
                                            </local:HudPanel>
                                        </Grid>

                                        <Button x:Name="ApplyKeyboardColorsButton" Content="APPLY ZONE COLORS"
                                                Margin="0 14 0 0" />
                                    </StackPanel>
                                </local:HudPanel>
                            </Border>

                            <!-- Lighting Effects -->
                            <Border Classes="Card" x:Name="KeyboardEffectsPanel">
                                <local:HudPanel Classes="Card">
                                    <StackPanel>
                                        <Grid Classes="CardHeader" ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="IconBadge">
                                                <material:MaterialIcon Kind="AutoFix" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="LIGHTING EFFECTS" Classes="SubHeader" />
                                                <TextBlock Text="// choose dynamic lighting effects for your keyboard"
                                                           Classes="Caption" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="[FX]" Classes="Tag"
                                                       VerticalAlignment="Top" />
                                        </Grid>
                                        <Border Classes="Rule" />

                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
                                              RowSpacing="14">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="MODE" Classes="FieldLabel" />
                                            <ComboBox x:Name="LightingModeComboBox" Grid.Row="0" Grid.Column="1"
                                                      SelectedIndex="0" Width="220" HorizontalAlignment="Left">
                                                <ComboBoxItem Content="Static Mode" />
                                                <ComboBoxItem Content="Breathing Mode" />
                                                <ComboBoxItem Content="Neon Mode" />
                                                <ComboBoxItem Content="Wave Mode" />
                                                <ComboBoxItem Content="Shifting Mode" />
                                                <ComboBoxItem Content="Zoom Mode" />
                                                <ComboBoxItem Content="Meteor Mode" />
                                                <ComboBoxItem Content="Twinkling Mode" />
                                            </ComboBox>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="SPEED" Classes="FieldLabel" />
                                            <Slider x:Name="LightingSpeedSlider" Grid.Row="1" Grid.Column="1" Value="5"
                                                    Maximum="9" Minimum="0" IsSnapToTickEnabled="True" TickFrequency="1" />
                                            <local:HudPanel Grid.Row="1" Grid.Column="2" Classes="Readout">
                                                <TextBlock x:Name="LightSpeedTextBlock" Text="5" />
                                            </local:HudPanel>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="COLOR" Classes="FieldLabel" />
                                            <ColorPicker x:Name="LightEffectColorPicker" Grid.Row="2" Grid.Column="1"
                                                         IsAlphaEnabled="False"
                                                         HexInputAlphaPosition="Trailing"
                                                         Color="#FFFF01"
                                                         HorizontalAlignment="Left"
                                                         Height="40"
                                                         Width="220" />

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="DIRECTION"
                                                       Classes="FieldLabel" />
                                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal"
                                                        Spacing="12">
                                                <RadioButton x:Name="LeftToRightRadioButton" GroupName="DirectionGroup"
                                                             IsChecked="True">
                                                    <StackPanel>
                                                        <material:MaterialIcon Kind="ArrowRight" />
                                                        <TextBlock Text="L-TO-R" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton x:Name="RightToLeftRadioButton" GroupName="DirectionGroup">
                                                    <StackPanel>
                                                        <material:MaterialIcon Kind="ArrowLeft" />
                                                        <TextBlock Text="R-TO-L" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </RadioButton>
                                            </StackPanel>
                                        </Grid>

                                        <Button x:Name="LightingEffectsApplyButton" Content="APPLY EFFECT"
                                                Margin="0 18 0 0" />
                                    </StackPanel>
                                </local:HudPanel>
                            </Border>

                            <!-- Backlight Timeout -->
                            <Border Classes="Card" x:Name="BacklightTimeoutControls">
                                <local:HudPanel Classes="Card">
                                    <StackPanel>
                                        <Grid Classes="CardHeader" ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="IconBadge">
                                                <material:MaterialIcon Kind="TimerOutline" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="BACKLIGHT TIMEOUT" Classes="SubHeader" />
                                                <TextBlock Classes="Caption"
                                                           Text="// turn off keyboard lighting after a period of inactivity" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="[T:30S]" Classes="Tag"
                                                       VerticalAlignment="Top" />
                                        </Grid>
                                        <Border Classes="Rule" />

                                        <CheckBox x:Name="BacklightTimeoutCheckBox"
                                                  Content="ENABLE BACKLIGHT TIMEOUT (30 SECONDS)" IsChecked="True" />
                                    </StackPanel>
                                </local:HudPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- System Settings Tab -->
                <TabItem x:Name="SystemSettingsPanel">
                    <TabItem.Header>
                        <StackPanel Classes="NavHeader" Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="05" Classes="NavIndex" />
                            <TextBlock Text="SYSTEM" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer Classes="Page">
                        <StackPanel>
                            <Grid Classes="PageHeader" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="SYSTEM SETTINGS" Classes="SectionHeader" />
                                    <TextBlock Text="&gt; DISPLAY, BOOT AND SYSTEM INFORMATION" Classes="Caption" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="6">
                                    <TextBlock Text="SEC_05 // SYS" Classes="Tag" HorizontalAlignment="Right" />
                                    <local:Stripes Width="140" Height="10" />
                                </StackPanel>
                            </Grid>

                            <!-- LCD Override -->
                            <Border Classes="Card" x:Name="LcdOverrideControls">
                                <local:HudPanel Classes="Card">
                                    <StackPanel>
                                        <Grid Classes="CardHeader" ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="IconBadge">
                                                <material:MaterialIcon Kind="MonitorShimmer" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="LCD OVERRIDE" Classes="SubHeader" />
                                                <TextBlock Text="// reduce lcd latency and minimize ghosting"
                                                           Classes="Caption" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="[LCD]" Classes="Tag"
                                                       VerticalAlignment="Top" />
                                        </Grid>
                                        <Border Classes="Rule" />

                                        <CheckBox x:Name="LcdOverrideCheckBox" Content="ENABLE LCD OVERRIDE"
                                                  IsChecked="True" />
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0 8 0 0">
                                            <material:MaterialIcon Kind="AlertOutline" Width="15" Height="15"
                                                                   Foreground="{StaticResource WarningBrush}" />
                                            <TextBlock Text="MAY INCREASE BATTERY CONSUMPTION" Classes="Caption Warning" />
                                        </StackPanel>
                                    </StackPanel>
                                </local:HudPanel>
                            </Border>

                            <!-- Boot Sound and Animation -->
                            <Border Classes="Card" x:Name="BootSoundControls">
                                <local:HudPanel Classes="Card">
                                    <StackPanel>
                                        <Grid Classes="CardHeader" ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="IconBadge">
                                                <material:MaterialIcon Kind="MusicNoteOutline" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="BOOT SOUND AND ANIMATION" Classes="SubHeader" />
                                                <TextBlock Text="// enable or disable custom boot animation and sound"
                                                           Classes="Caption" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="[BOOT]" Classes="Tag"
                                                       VerticalAlignment="Top" />
                                        </Grid>
                                        <Border Classes="Rule" />

                                        <CheckBox x:Name="BootAnimAndSoundCheckBox"
                                                  Content="ENABLE BOOT ANIMATION AND SOUND" IsChecked="False" />
                                    </StackPanel>
                                </local:HudPanel>
                            </Border>

                            <!-- System Information -->
                            <Border Classes="Card">
                                <local:HudPanel Classes="Card">
                                    <StackPanel>
                                        <Grid Classes="CardHeader" ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="IconBadge">
                                                <material:MaterialIcon Kind="InformationOutline" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="SYSTEM INFORMATION" Classes="SubHeader" />
                                                <TextBlock Text="// detected hardware and component versions"
                                                           Classes="Caption" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="[SYS.INFO]" Classes="Tag"
                                                       VerticalAlignment="Top" />
                                        </Grid>
                                        <Border Classes="Rule" />

                                        <Grid Classes="KeyValue" ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Text="MODEL" Classes="Key" />
                                            <local:DotLeader Grid.Column="1" />
                                            <TextBlock x:Name="ModelNameText" Grid.Column="2" Text="UNKNOWN"
                                                       Classes="Value" />
                                        </Grid>
                                        <Grid Classes="KeyValue" ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Text="LAPTOP_TYPE" Classes="Key" />
                                            <local:DotLeader Grid.Column="1" />
                                            <TextBlock x:Name="LaptopTypeText" Grid.Column="2" Text="UNKNOWN"
                                                       Classes="Value" />
                                        </Grid>
                                        <Grid Classes="KeyValue" ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Text="DAEMON_VER" Classes="Key" />
                                            <local:DotLeader Grid.Column="1" />
                                            <TextBlock x:Name="DaemonVersionText" Grid.Column="2" Text="UNKNOWN"
                                                       Classes="Value" />
                                        </Grid>
                                        <Grid Classes="KeyValue" ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Text="DRIVER_VER" Classes="Key" />
                                            <local:DotLeader Grid.Column="1" />
                                            <TextBlock x:Name="DriverVersionText" Grid.Column="2" Text="UNKNOWN"
                                                       Classes="Value" />
                                        </Grid>
                                        <Grid Classes="KeyValue" ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Text="PROJECT_VER" Classes="Key" />
                                            <local:DotLeader Grid.Column="1" />
                                            <TextBlock x:Name="ProjectVersionText" Grid.Column="2" Text="UNKNOWN"
                                                       Classes="Value" />
                                        </Grid>
                                        <Grid Classes="KeyValue" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                            <TextBlock Text="FEATURES" Classes="Key" />
                                            <local:DotLeader Grid.Column="1" />
                                            <TextBlock x:Name="SupportedFeaturesTextBlock" Grid.Row="1"
                                                       Grid.ColumnSpan="2" Text="UNKNOWN" Margin="0 8 0 0"
                                                       Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                        </Grid>

                                        <WrapPanel Orientation="Horizontal" Margin="0 16 0 0" ItemSpacing="10"
                                                   LineSpacing="10">
                                            <Button x:Name="UpdatesButton" Content="CHECK FOR UPDATES"
                                                    Click="UpdatesButton_OnClick" />
                                            <Button x:Name="DeveloperModeButton" Content="DEVELOPER MODE"
                                                    Classes="Secondary"
                                                    IsVisible="False"
                                                    Click="DeveloperMode_OnClick" />
                                            <Button x:Name="IssuePageButton" Content="ISSUE / FEEDBACK"
                                                    Classes="Secondary"
                                                    Click="IssuePageButton_OnClick" />
                                            <Button x:Name="InternalsManagerButton" Content="INTERNALS MANAGER"
                                                    Classes="Secondary"
                                                    Click="InternalsMangerWindow_OnClick" />
                                        </WrapPanel>
                                    </StackPanel>
                                </local:HudPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- CRT scanlines over everything (not hit-testable) -->
        <local:Scanlines Fill="{StaticResource ScanlineBrush}" Pitch="3" ZIndex="50" />

        <!-- Overlay Grid (on separate layer) -->
        <Grid x:Name="DaemonErrorGrid" Panel.ZIndex="100" Background="#CC050807" IsHitTestVisible="True"
              IsVisible="True">
            <local:HudPanel Width="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Cut="18" Padding="30 26"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource DangerBrush}"
                            AccentBrush="{StaticResource DangerBrush}" AccentLength="90">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="Auto,*">
                        <material:MaterialIcon Kind="LanDisconnect" Foreground="{StaticResource DangerBrush}"
                                               Width="26" Height="26" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="LINK FAILURE" Margin="12 0 0 0"
                                   FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                                   FontSize="22" LetterSpacing="4" VerticalAlignment="Center"
                                   Foreground="{StaticResource DangerBrush}" />
                    </Grid>
                    <local:Stripes Height="6" Margin="0 10 0 6" Fill="#66FF5F5F" />

                    <TextBlock Text="&gt; STATUS: DAEMON NOT CONNECTED" Margin="0" FontWeight="Bold" />
                    <TextBlock Text="&gt; daemon may be initializing. please wait a minute."
                               Classes="Hint" Margin="0" TextWrapping="Wrap" />
                    <TextBlock Text="&gt; if the issue persists, check the logs."
                               Classes="Hint" Margin="0 0 0 14" TextWrapping="Wrap" />

                    <Button Content="RETRY CONNECTION"
                            HorizontalAlignment="Left"
                            Click="RetryConnectionButton_OnClick" />
                </StackPanel>
            </local:HudPanel>
        </Grid>
    </Grid>
</Window>
