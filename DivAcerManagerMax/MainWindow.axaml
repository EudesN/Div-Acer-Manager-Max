<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:DivAcerManagerMax"
        xmlns:material="using:Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"

        x:Class="DivAcerManagerMax.MainWindow"
        Title="DAMX"
        Icon="iconTransparent.png"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="Full"
        Background="{StaticResource AppBackgroundBrush}"

        Width="1200" Height="760"
        MinWidth="1100" MinHeight="560">

    <Window.Styles>
        <!-- The tab strip sits on top of the sidebar panel drawn behind the TabControl. -->
        <Style Selector="TabControl.Sidebar /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="Width" Value="224" />
            <Setter Property="Margin" Value="12 104 12 12" />
        </Style>

        <!-- Page content area to the right of the sidebar -->
        <Style Selector="TabControl.Sidebar ScrollViewer.Page > StackPanel">
            <Setter Property="Margin" Value="36 30 36 24" />
            <Setter Property="MaxWidth" Value="1040" />
        </Style>

        <!-- Inner tile used to group a zone colour picker -->
        <Style Selector="Border.Tile">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16 12 16 14" />
            <Setter Property="Margin" Value="0 0 12 12" />
        </Style>
        <Style Selector="Border.Tile TextBlock">
            <Setter Property="Margin" Value="0 0 0 10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Label / value rows in System Information -->
        <Style Selector="Grid.InfoGrid TextBlock">
            <Setter Property="Margin" Value="0 7" />
        </Style>
        <Style Selector="Grid.InfoGrid TextBlock.Key">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Width" Value="150" />
        </Style>
        <Style Selector="Grid.InfoGrid TextBlock.Value">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Small pill showing a slider's value -->
        <Style Selector="Border.ValuePill">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8 3" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Margin" Value="14 0 0 0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.ValuePill TextBlock">
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Width" Value="96" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>
    </Window.Styles>

    <Grid>

        <Grid ColumnDefinitions="248,*">

            <!-- Sidebar panel (the navigation items are the TabControl's strip, laid over it) -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0 0 1 0">
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="22 26 16 0"
                            VerticalAlignment="Top">
                    <Border Width="46" Height="46" CornerRadius="13" ClipToBounds="True"
                            Background="{StaticResource AccentSoftBrush}"
                            BorderBrush="#333B9EFF" BorderThickness="1">
                        <Image Source="iconTransparent.png" Margin="5" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DAMX" FontSize="22" LetterSpacing="3" Margin="0"
                                   FontFamily="{StaticResource OxaniumBoldFont}" FontWeight="Bold"
                                   Foreground="{StaticResource BrandGradientBrush}" />
                        <TextBlock Text="Div Acer Manager Max" Classes="Caption" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Main Content -->
            <TabControl Grid.Column="0" Grid.ColumnSpan="2" Classes="Sidebar" TabStripPlacement="Left"
                        Background="Transparent" BorderThickness="0" Padding="0">
                <TabControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="2" />
                    </ItemsPanelTemplate>
                </TabControl.ItemsPanel>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Classes="NavHeader" Orientation="Horizontal" Spacing="12">
                            <material:MaterialIcon Kind="ViewDashboardOutline" />
                            <TextBlock Text="Dashboard" />
                        </StackPanel>
                    </TabItem.Header>

                    <views:Dashboard />

                </TabItem>

                <!-- Power & Performance Tab -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Classes="NavHeader" Orientation="Horizontal" Spacing="12">
                            <material:MaterialIcon Kind="Speedometer" />
                            <TextBlock Text="Power &amp; Performance" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer Classes="Page">
                        <StackPanel>
                            <StackPanel Classes="PageHeader">
                                <TextBlock Text="Power &amp; Performance" Classes="SectionHeader" />
                                <TextBlock Text="Thermal profiles and fan behaviour" Classes="Caption" />
                            </StackPanel>

                            <Border Classes="Card" x:Name="ThermalProfilePanel">
                                <StackPanel>
                                    <Grid Classes="CardHeader" ColumnDefinitions="Auto,*,Auto">
                                        <Border Classes="IconBadge">
                                            <material:MaterialIcon Kind="Speedometer" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Performance Profiles" Classes="SubHeader" />
                                            <TextBlock Classes="Caption"
                                                       Text="Configure thermal profiles to balance performance and temperature" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="PluggedInToggleSwitch" Grid.Column="2"
                                                      VerticalAlignment="Center" IsChecked="True"
                                                      IsHitTestVisible="False">
                                            <ToggleSwitch.OffContent>
                                                <material:MaterialIcon Kind="BatteryOutline" Width="22" Height="22" />
                                            </ToggleSwitch.OffContent>
                                            <ToggleSwitch.OnContent>
                                                <material:MaterialIcon Kind="PowerPlugOutline" Width="22" Height="22" />
                                            </ToggleSwitch.OnContent>
                                        </ToggleSwitch>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                        <RadioButton x:Name="LowPowerProfileButton" GroupName="ProfileGroup"
                                                     IsVisible="{Binding ElementName=PluggedInToggleSwitch, Path=!IsChecked}">
                                            <StackPanel>
                                                <material:MaterialIcon Kind="Leaf" />
                                                <TextBlock Text="Eco" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>

                                        <RadioButton x:Name="QuietProfileButton" GroupName="ProfileGroup"
                                                     IsVisible="{Binding ElementName=PluggedInToggleSwitch, Path=IsChecked}">
                                            <StackPanel>
                                                <material:MaterialIcon Kind="FanMinus" />
                                                <TextBlock Text="Quiet" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>

                                        <RadioButton x:Name="BalancedProfileButton" GroupName="ProfileGroup"
                                                     IsChecked="True">
                                            <StackPanel>
                                                <material:MaterialIcon Kind="ScaleBalance" />
                                                <TextBlock Text="Balanced" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>

                                        <RadioButton x:Name="PerformanceProfileButton" GroupName="ProfileGroup"
                                                     IsVisible="{Binding ElementName=PluggedInToggleSwitch, Path=IsChecked}">
                                            <StackPanel>
                                                <material:MaterialIcon Kind="SpeedometerMedium" />
                                                <TextBlock Text="Performance" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>

                                        <RadioButton x:Name="TurboProfileButton" GroupName="ProfileGroup"
                                                     IsVisible="{Binding ElementName=PluggedInToggleSwitch, Path=IsChecked}">
                                            <StackPanel>
                                                <material:MaterialIcon Kind="RocketLaunch" />
                                                <TextBlock Text="Turbo" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>

                                    <TextBlock x:Name="ThermalProfileInfoText" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="13" Margin="0 18 0 0"
                                               Text="Performance profiles are preset modes that control your device's speed, power use, and cooling:"
                                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Fan Speed Control -->
                            <Border Classes="Card" x:Name="FanControlPanel">
                                <StackPanel>
                                    <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                                        <Border Classes="IconBadge">
                                            <material:MaterialIcon Kind="Fan" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Fan Speed Control" Classes="SubHeader" />
                                            <TextBlock Text="Set custom fan speeds for CPU and GPU" Classes="Caption" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                        <RadioButton x:Name="AutoFanSpeedRadioButton" GroupName="FanModeGroup"
                                                     IsChecked="True">
                                            <StackPanel>
                                                <material:MaterialIcon Kind="AutoAwesome" />
                                                <TextBlock Text="Auto" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>

                                        <RadioButton x:Name="MaxFanSpeedRadioButton" GroupName="FanModeGroup"
                                                     Click="MaxFanSpeedRadioButton_OnClick">
                                            <StackPanel>
                                                <material:MaterialIcon Kind="Turbine" />
                                                <TextBlock Text="Max" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>

                                        <RadioButton x:Name="ManualFanSpeedRadioButton" GroupName="FanModeGroup">
                                            <StackPanel>
                                                <material:MaterialIcon Kind="TuneVariant" />
                                                <TextBlock Text="Manual" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>

                                    <TextBlock x:Name="ManualDisabledInfoText" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="13"
                                               Text="Manual fan controls are disabled to ensure quiet operation"
                                               HorizontalAlignment="Center" Margin="0 18 0 0"
                                               IsVisible="{Binding ElementName=QuietProfileButton, Path=IsChecked}" />

                                    <StackPanel Margin="0 22 0 0"
                                                IsVisible="{Binding ElementName=ManualFanSpeedRadioButton , Path=IsChecked}">

                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU Fan"
                                                       Classes="FieldLabel" />
                                            <Slider x:Name="CpuFanSlider" Grid.Row="0" Grid.Column="1" Value="50" />
                                            <Border Grid.Row="0" Grid.Column="2" Classes="ValuePill">
                                                <TextBlock x:Name="CpuFanTextBlock" Text="50%" />
                                            </Border>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="GPU Fan"
                                                       Classes="FieldLabel" />
                                            <Slider x:Name="GpuFanSlider" Grid.Row="1" Grid.Column="1" Value="70" />
                                            <Border Grid.Row="1" Grid.Column="2" Classes="ValuePill">
                                                <TextBlock x:Name="GpuFanTextBlock" Text="70%" />
                                            </Border>
                                        </Grid>

                                        <Grid ColumnDefinitions="Auto,*" Margin="0 14 0 0">
                                            <Button x:Name="SetManualSpeedButton" Content="Apply Fan Settings"
                                                    Click="SetManualSpeedButton_OnClick" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <material:MaterialIcon Kind="AlertOutline" Width="16" Height="16"
                                                                       Foreground="{StaticResource WarningBrush}" />
                                                <TextBlock Text="Low fan speeds may result in higher temperatures"
                                                           Classes="Caption Warning" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Power Controls Tab -->
                <TabItem x:Name="BatteryPanel">
                    <TabItem.Header>
                        <StackPanel Classes="NavHeader" Orientation="Horizontal" Spacing="12">
                            <material:MaterialIcon Kind="BatteryChargingHigh" />
                            <TextBlock Text="Battery Controls" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer Classes="Page">
                        <StackPanel>
                            <StackPanel Classes="PageHeader">
                                <TextBlock Text="Power Controls" Classes="SectionHeader" />
                                <TextBlock Text="Battery health and USB charging" Classes="Caption" />
                            </StackPanel>

                            <!-- Battery Calibration -->
                            <Border Classes="Card" x:Name="CalibrationControls">
                                <StackPanel>
                                    <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                                        <Border Classes="IconBadge">
                                            <material:MaterialIcon Kind="BatterySync" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Battery Calibration" Classes="SubHeader" />
                                            <TextBlock Classes="Caption"
                                                       Text="Calibrate your battery to get accurate battery percentage readings" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Name="CalibrationStatusTextBlock" Margin="0"
                                                       Text="Status: Not calibrating" FontWeight="SemiBold" />
                                            <TextBlock
                                                Text="Battery calibration will fully charge, drain, and recharge your battery."
                                                TextWrapping="Wrap" Margin="0 6 0 0" Classes="Caption" FontSize="13" />
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0 8 0 0">
                                                <material:MaterialIcon Kind="AlertOutline" Width="16" Height="16"
                                                                       Foreground="{StaticResource WarningBrush}" />
                                                <TextBlock Text="Do not unplug AC power during calibration."
                                                           Classes="Caption Warning" FontSize="13" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                                    VerticalAlignment="Center" Margin="20 0 0 0">
                                            <Button x:Name="StopCalibrationButton" Content="Stop"
                                                    Classes="Secondary" IsEnabled="False" />
                                            <Button x:Name="StartCalibrationButton" Content="Start Calibration" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Charge Limit -->
                            <Border Classes="Card" x:Name="LimiterControls">
                                <StackPanel>
                                    <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                                        <Border Classes="IconBadge Success">
                                            <material:MaterialIcon Kind="BatteryHeartVariant" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Battery Charge Limit" Classes="SubHeader" />
                                            <TextBlock Classes="Caption"
                                                       Text="Limit maximum battery charge to 80% to extend battery lifespan" />
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox x:Name="BatteryLimitCheckBox" Content="Enable battery limit (80%)" />

                                    <TextBlock Text="Recommended for laptops that are frequently connected to AC power"
                                               Classes="Caption" FontSize="13" TextWrapping="Wrap" Margin="0 8 0 0" />
                                </StackPanel>
                            </Border>

                            <!-- USB Power Delivery -->
                            <Border Classes="Card" x:Name="UsbChargingPanel">
                                <StackPanel>
                                    <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                                        <Border Classes="IconBadge">
                                            <material:MaterialIcon Kind="UsbPort" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="USB Power Delivery" Classes="SubHeader" />
                                            <TextBlock Text="Configure USB charging when laptop is powered off"
                                                       Classes="Caption" />
                                        </StackPanel>
                                    </Grid>

                                    <ComboBox x:Name="UsbChargingComboBox" SelectedIndex="2" Width="300"
                                              HorizontalAlignment="Left"
                                              SelectionChanged="UsbChargingComboBox_OnSelectionChanged">
                                        <ComboBoxItem Content="Disabled" />
                                        <ComboBoxItem Content="Until battery reaches 10%" />
                                        <ComboBoxItem Content="Until battery reaches 20%" />
                                        <ComboBoxItem Content="Until battery reaches 30%" />
                                    </ComboBox>

                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </ScrollViewer>
                </TabItem>

                <!-- Keyboard Lighting Tab -->
                <TabItem x:Name="KeyboardLightingPanel">
                    <TabItem.Header>
                        <StackPanel Classes="NavHeader" Orientation="Horizontal" Spacing="12">
                            <material:MaterialIcon Kind="KeyboardOutline" />
                            <TextBlock Text="Keyboard Lighting" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer Classes="Page">
                        <StackPanel>
                            <StackPanel Classes="PageHeader">
                                <TextBlock Text="Keyboard Lighting" Classes="SectionHeader" />
                                <TextBlock Text="Zone colours, effects and backlight" Classes="Caption" />
                            </StackPanel>

                            <Border Classes="Notice">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <material:MaterialIcon Kind="FlaskOutline" Width="16" Height="16" />
                                    <TextBlock Text="This section requires testing." />
                                </StackPanel>
                            </Border>

                            <!-- Zone Color Control -->
                            <Border Classes="Card" x:Name="ZoneColorControlPanel">
                                <StackPanel>
                                    <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                                        <Border Classes="IconBadge">
                                            <material:MaterialIcon Kind="Palette" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Zone Color Control" Classes="SubHeader" />
                                            <TextBlock Text="Customize colors for each keyboard zone" Classes="Caption" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*,*,*" Margin="0 0 -12 0">
                                        <!-- Zone 1 -->
                                        <Border Grid.Column="0" Classes="Tile">
                                            <StackPanel>
                                                <TextBlock Text="Zone 1" />
                                                <Border x:Name="Zone1Border" Background="#4287f5" Height="30"
                                                        CornerRadius="3" IsVisible="False" />
                                                <ColorPicker x:Name="Zone1ColorPicker"
                                                             IsAlphaEnabled="False"
                                                             IsAlphaVisible="False"
                                                             Color="#4287f5"
                                                             HorizontalAlignment="Left"
                                                             Height="44"
                                                             Width="160" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Zone 2 -->
                                        <Border Grid.Column="1" Classes="Tile">
                                            <StackPanel>
                                                <TextBlock Text="Zone 2" />
                                                <Border x:Name="Zone2Border" Background="#ff5733" Height="30"
                                                        CornerRadius="3" IsVisible="False" />
                                                <ColorPicker x:Name="Zone2ColorPicker"
                                                             IsAlphaEnabled="False"
                                                             HexInputAlphaPosition="Trailing"
                                                             Color="#ff5733"
                                                             HorizontalAlignment="Left"
                                                             Height="44"
                                                             Width="160" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Zone 3 -->
                                        <Border Grid.Column="2" Classes="Tile">
                                            <StackPanel>
                                                <TextBlock Text="Zone 3" />
                                                <Border x:Name="Zone3Border" Background="#33ff57" Height="30"
                                                        CornerRadius="3" IsVisible="False" />
                                                <ColorPicker x:Name="Zone3ColorPicker"
                                                             IsAlphaEnabled="False"
                                                             HexInputAlphaPosition="Trailing"
                                                             Color="#33ff57"
                                                             HorizontalAlignment="Left"
                                                             Height="44"
                                                             Width="160" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Zone 4 -->
                                        <Border Grid.Column="3" Classes="Tile">
                                            <StackPanel>
                                                <TextBlock Text="Zone 4" />
                                                <ColorPicker x:Name="Zone4ColorPicker"
                                                             IsAlphaEnabled="False"
                                                             HexInputAlphaPosition="Trailing"
                                                             Color="#FFFF01"
                                                             HorizontalAlignment="Left"
                                                             Height="44"
                                                             Width="160" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Brightness -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0 8 0 0">
                                        <TextBlock Grid.Column="0" Text="Brightness" Classes="FieldLabel" />
                                        <Slider x:Name="KeyBrightnessSlider" Grid.Column="1" Value="100" />
                                        <Border Grid.Column="2" Classes="ValuePill">
                                            <TextBlock x:Name="KeyBrightnessText" Text="100%" />
                                        </Border>
                                    </Grid>

                                    <Button x:Name="ApplyKeyboardColorsButton" Content="Apply Zone Colors"
                                            Margin="0 14 0 0" />
                                </StackPanel>
                            </Border>

                            <!-- Lighting Effects -->
                            <Border Classes="Card" x:Name="KeyboardEffectsPanel">
                                <StackPanel>
                                    <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                                        <Border Classes="IconBadge">
                                            <material:MaterialIcon Kind="AutoFix" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Lighting Effects" Classes="SubHeader" />
                                            <TextBlock Text="Choose dynamic lighting effects for your keyboard"
                                                       Classes="Caption" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
                                          RowSpacing="14">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Mode" Classes="FieldLabel" />
                                        <ComboBox x:Name="LightingModeComboBox" Grid.Row="0" Grid.Column="1"
                                                  SelectedIndex="0" Width="220" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="Static Mode" />
                                            <ComboBoxItem Content="Breathing Mode" />
                                            <ComboBoxItem Content="Neon Mode" />
                                            <ComboBoxItem Content="Wave Mode" />
                                            <ComboBoxItem Content="Shifting Mode" />
                                            <ComboBoxItem Content="Zoom Mode" />
                                            <ComboBoxItem Content="Meteor Mode" />
                                            <ComboBoxItem Content="Twinkling Mode" />
                                        </ComboBox>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Speed" Classes="FieldLabel" />
                                        <Slider x:Name="LightingSpeedSlider" Grid.Row="1" Grid.Column="1" Value="5"
                                                Maximum="9" Minimum="0" IsSnapToTickEnabled="True" TickFrequency="1" />
                                        <Border Grid.Row="1" Grid.Column="2" Classes="ValuePill">
                                            <TextBlock x:Name="LightSpeedTextBlock" Text="5" />
                                        </Border>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Color" Classes="FieldLabel" />
                                        <ColorPicker x:Name="LightEffectColorPicker" Grid.Row="2" Grid.Column="1"
                                                     IsAlphaEnabled="False"
                                                     HexInputAlphaPosition="Trailing"
                                                     Color="#FFFF01"
                                                     HorizontalAlignment="Left"
                                                     Height="44"
                                                     Width="220" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Direction" Classes="FieldLabel" />
                                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                            <RadioButton x:Name="LeftToRightRadioButton" GroupName="DirectionGroup"
                                                         IsChecked="True">
                                                <StackPanel>
                                                    <material:MaterialIcon Kind="ArrowRight" />
                                                    <TextBlock Text="Left To Right" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="RightToLeftRadioButton" GroupName="DirectionGroup">
                                                <StackPanel>
                                                    <material:MaterialIcon Kind="ArrowLeft" />
                                                    <TextBlock Text="Right to Left" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </RadioButton>
                                        </StackPanel>
                                    </Grid>

                                    <Button x:Name="LightingEffectsApplyButton" Content="Apply Effect"
                                            Margin="0 18 0 0" />
                                </StackPanel>
                            </Border>

                            <!-- Backlight Timeout -->
                            <Border Classes="Card" x:Name="BacklightTimeoutControls">
                                <StackPanel>
                                    <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                                        <Border Classes="IconBadge">
                                            <material:MaterialIcon Kind="TimerOutline" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Backlight Timeout" Classes="SubHeader" />
                                            <TextBlock Classes="Caption"
                                                       Text="Automatically turn off keyboard lighting after period of inactivity" />
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox x:Name="BacklightTimeoutCheckBox"
                                              Content="Enable backlight timeout (30 seconds)" IsChecked="True" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- System Settings Tab -->
                <TabItem x:Name="SystemSettingsPanel">
                    <TabItem.Header>
                        <StackPanel Classes="NavHeader" Orientation="Horizontal" Spacing="12">
                            <material:MaterialIcon Kind="CogOutline" />
                            <TextBlock Text="System Settings" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer Classes="Page">
                        <StackPanel>
                            <StackPanel Classes="PageHeader">
                                <TextBlock Text="System Settings" Classes="SectionHeader" />
                                <TextBlock Text="Display, boot and system information" Classes="Caption" />
                            </StackPanel>

                            <!-- LCD Override -->
                            <Border Classes="Card" x:Name="LcdOverrideControls">
                                <StackPanel>
                                    <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                                        <Border Classes="IconBadge">
                                            <material:MaterialIcon Kind="MonitorShimmer" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="LCD Override" Classes="SubHeader" />
                                            <TextBlock Text="Reduce LCD latency and minimize ghosting" Classes="Caption" />
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox x:Name="LcdOverrideCheckBox" Content="Enable LCD Override"
                                              IsChecked="True" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0 8 0 0">
                                        <material:MaterialIcon Kind="AlertOutline" Width="16" Height="16"
                                                               Foreground="{StaticResource WarningBrush}" />
                                        <TextBlock Text="May increase battery consumption" Classes="Caption Warning"
                                                   FontSize="13" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Boot Sound and Animation -->
                            <Border Classes="Card" x:Name="BootSoundControls">
                                <StackPanel>
                                    <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                                        <Border Classes="IconBadge">
                                            <material:MaterialIcon Kind="MusicNoteOutline" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Boot Sound and Animation" Classes="SubHeader" />
                                            <TextBlock Text="Enable or disable custom boot animation and sound"
                                                       Classes="Caption" />
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox x:Name="BootAnimAndSoundCheckBox"
                                              Content="Enable boot animation and sound" IsChecked="False" />
                                </StackPanel>
                            </Border>

                            <!-- System Information -->
                            <Border Classes="Card">
                                <StackPanel>
                                    <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                                        <Border Classes="IconBadge">
                                            <material:MaterialIcon Kind="InformationOutline" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="System Information" Classes="SubHeader" />
                                            <TextBlock Text="Detected hardware and component versions"
                                                       Classes="Caption" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Classes="InfoGrid" ColumnDefinitions="Auto,*"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Model" Classes="Key" />
                                        <TextBlock x:Name="ModelNameText" Grid.Row="0" Grid.Column="1" Text="UNKNOWN"
                                                   Classes="Value" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Laptop Type" Classes="Key" />
                                        <TextBlock x:Name="LaptopTypeText" Grid.Row="1" Grid.Column="1" Text="UNKNOWN"
                                                   Classes="Value" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Features" Classes="Key" />
                                        <TextBlock x:Name="SupportedFeaturesTextBlock" Grid.Row="2" Grid.Column="1"
                                                   Text="UNKNOWN" Classes="Value" TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Daemon Version" Classes="Key" />
                                        <TextBlock x:Name="DaemonVersionText" Grid.Row="3" Grid.Column="1"
                                                   Text="UNKNOWN" Classes="Value" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Driver Version" Classes="Key" />
                                        <TextBlock x:Name="DriverVersionText" Grid.Row="4" Grid.Column="1"
                                                   Text="UNKNOWN" Classes="Value" />

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Project Version" Classes="Key" />
                                        <TextBlock x:Name="ProjectVersionText" Grid.Row="5" Grid.Column="1"
                                                   Text="UNKNOWN" Classes="Value" />
                                    </Grid>

                                    <WrapPanel Orientation="Horizontal" Margin="0 16 0 0" ItemSpacing="10">
                                        <Button x:Name="UpdatesButton" Content="Check for Updates"
                                                Click="UpdatesButton_OnClick" />
                                        <Button x:Name="DeveloperModeButton" Content="Developer Mode" Classes="Secondary"
                                                IsVisible="False"
                                                Click="DeveloperMode_OnClick" />
                                        <Button x:Name="IssuePageButton" Content="Issue/Feedback" Classes="Secondary"
                                                Click="IssuePageButton_OnClick" />
                                        <Button x:Name="InternalsManagerButton" Content="Internals Manager"
                                                Classes="Secondary"
                                                Click="InternalsMangerWindow_OnClick" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Overlay Grid (on separate layer) -->
        <Grid x:Name="DaemonErrorGrid" Panel.ZIndex="100" Background="#B30A0C10" IsHitTestVisible="True"
              IsVisible="True">
            <Border
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource StrokeStrongBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Padding="32 28"
                Width="420"
                BoxShadow="0 24 64 0 #80000000"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <Border Width="56" Height="56" CornerRadius="16" Background="#1FF2555A"
                            HorizontalAlignment="Center">
                        <material:MaterialIcon Kind="LanDisconnect" Foreground="{StaticResource DangerBrush}"
                                               Width="28" Height="28" />
                    </Border>

                    <TextBlock Text="Daemon not connected"
                               FontSize="19" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0 10 0 0" />

                    <TextBlock
                        Text="Daemon may be initializing. Please wait a minute. If issues persists, check logs."
                        Foreground="{StaticResource TextMutedBrush}"
                        FontSize="13"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="0 0 0 12" />

                    <Button Content="Retry"
                            MinWidth="120"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            Click="RetryConnectionButton_OnClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
