<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:DivAcerManagerMax"
        xmlns:local="using:DivAcerManagerMax"
        xmlns:material="using:Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"

        x:Class="DivAcerManagerMax.MainWindow"
        Title="DAMX // Acer Control"
        Icon="iconTransparent.png"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="Full"
        Background="{StaticResource BgBrush}"

        Width="1280" Height="720"
        MinWidth="1100" MinHeight="600">

    <Window.Styles>
        <!-- The nav strip sits on top of the sidebar panel drawn behind the TabControl. -->
        <Style Selector="TabControl.Sidebar /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="Width" Value="152" />
            <Setter Property="Margin" Value="8 16 8 8" />
        </Style>

        <!-- Page content area to the right of the sidebar -->
        <Style Selector="TabControl.Sidebar ScrollViewer.Page > StackPanel">
            <Setter Property="Margin" Value="24" />
            <Setter Property="MaxWidth" Value="1180" />
        </Style>

        <Style Selector="local|HudPanel.Tile TextBlock.TileTitle">
            <Setter Property="Margin" Value="0 0 0 8" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
        </Style>

        <!-- "KEY ........ VALUE" rows -->
        <Style Selector="Grid.KeyValue TextBlock.Value">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Width" Value="96" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
        </Style>

        <!-- Header brand -->
        <Style Selector="StackPanel.Brand > TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LetterSpacing" Value="1.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Non-blocking status toast -->
        <Style Selector="local|HudPanel.Toast">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
            <Setter Property="Cut" Value="8" />
            <Setter Property="CutTopLeft" Value="False" />
            <Setter Property="CutBottomLeft" Value="False" />
            <Setter Property="Padding" Value="14 10" />
        </Style>
        <Style Selector="local|HudPanel.Toast.Error">
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
        </Style>

    </Window.Styles>

    <Grid RowDefinitions="40,*">

        <!-- ============================================================ Header bar -->
        <!-- Minimal: wordmark, muted model, status dot + text; one hairline at the bottom -->
        <Border Grid.Row="0" Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0 0 0 1">
            <Panel>
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="16 0">
                    <Image Source="iconTransparent.png" Width="16" Height="16" VerticalAlignment="Center"
                           Margin="0 0 10 0" />
                    <StackPanel Grid.Column="1" Classes="Brand" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="DAMX" Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="// ACER CONTROL" Foreground="{StaticResource InkMutedBrush}" />
                    </StackPanel>

                    <TextBlock x:Name="HeaderModelText" Grid.Column="3" Text="—" Classes="Mono"
                               FontSize="11" Foreground="{StaticResource InkMutedBrush}"
                               VerticalAlignment="Center" Margin="0 0 20 0" MaxWidth="320"
                               TextTrimming="CharacterEllipsis" />

                    <Border x:Name="DaemonStatusChip" Grid.Column="4" Classes="Chip"
                            BorderThickness="0" Padding="0"
                            Background="Transparent" Cursor="Hand"
                            Tapped="DaemonStatusChip_OnTapped"
                            ToolTip.Tip="Daemon connection (/var/run/DAMX.sock). Click to reconnect.">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="DaemonStatusDot" Classes="StatusDot" />
                            <TextBlock x:Name="DaemonStatusText" Text="CONNECTING" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Panel>
        </Border>

        <!-- ============================================================ Body -->
        <Grid Grid.Row="1" ColumnDefinitions="168,*">

            <!-- Sidebar panel (the navigation items are the TabControl's strip, laid over it) -->
            <Border Grid.Column="0" Background="{StaticResource BgBrush}"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0 0 1 0">
            </Border>

            <TabControl Grid.Column="0" Grid.ColumnSpan="2" Classes="Sidebar" TabStripPlacement="Left"
                        Background="Transparent" BorderThickness="0" Padding="0">
                <TabControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="2" />
                    </ItemsPanelTemplate>
                </TabControl.ItemsPanel>

                <!-- ==================================================== 01 Dashboard -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Classes="NavHeader" Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="DASHBOARD" />
                        </StackPanel>
                    </TabItem.Header>

                    <!-- Telemetry + thermal profile + fan control live in Dashboard.axaml -->
                    <views:Dashboard x:Name="DashboardView" />
                </TabItem>

                <!-- ==================================================== 02 Battery -->
                <TabItem x:Name="BatteryPanel">
                    <TabItem.Header>
                        <StackPanel Classes="NavHeader" Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="BATTERY" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer Classes="Page" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <StackPanel Margin="0 0 0 20">
                                <TextBlock Text="BATTERY" Classes="PageTitle" />
                            </StackPanel>

                            <!-- Battery Calibration -->
                            <local:HudPanel x:Name="CalibrationControls" Classes="Card" Margin="0 0 0 16">
                                <StackPanel>
                                    <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="BATTERY CALIBRATION" Classes="CardTitle" />
                                            <TextBlock Classes="CardCaption"
                                                       Text="Full charge, drain and recharge cycle for accurate percentage readings" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="6">
                                            <TextBlock x:Name="CalibrationStatusTextBlock" Classes="Value"
                                                       Text="Status: Not calibrating" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <material:MaterialIcon Kind="AlertOutline" Width="14" Height="14"
                                                                       Classes="Danger" />
                                                <TextBlock Text="Do not unplug AC power during calibration"
                                                           Classes="Hint Warning" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                    VerticalAlignment="Center" Margin="16 0 0 0">
                                            <Button x:Name="StopCalibrationButton" Content="STOP" IsEnabled="False" />
                                            <Button x:Name="StartCalibrationButton" Content="START CALIBRATION"
                                                    Classes="Primary" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </local:HudPanel>

                            <Grid ColumnDefinitions="*,*">
                                <!-- Charge Limit -->
                                <local:HudPanel x:Name="LimiterControls" Classes="Card" Grid.Column="0"
                                                Margin="0 0 8 16">
                                    <StackPanel>
                                        <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="CHARGE LIMIT" Classes="CardTitle" />
                                                <TextBlock Classes="CardCaption"
                                                           Text="Stop charging at 80 % to extend battery lifespan" />
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox x:Name="BatteryLimitCheckBox" Content="Limit charge to 80 %" />
                                        <TextBlock Classes="Hint" Margin="0 8 0 0"
                                                   Text="Recommended when the laptop is usually plugged in." />
                                    </StackPanel>
                                </local:HudPanel>

                                <!-- USB Power Delivery -->
                                <local:HudPanel x:Name="UsbChargingPanel" Classes="Card" Grid.Column="1"
                                                Margin="8 0 0 16">
                                    <StackPanel>
                                        <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="USB POWER-OFF CHARGING" Classes="CardTitle" />
                                                <TextBlock Classes="CardCaption"
                                                           Text="Charge USB devices while the laptop is off" />
                                            </StackPanel>
                                        </Grid>
                                        <ComboBox x:Name="UsbChargingComboBox" SelectedIndex="2"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="UsbChargingComboBox_OnSelectionChanged">
                                            <ComboBoxItem Content="Disabled" />
                                            <ComboBoxItem Content="Until battery reaches 10%" />
                                            <ComboBoxItem Content="Until battery reaches 20%" />
                                            <ComboBoxItem Content="Until battery reaches 30%" />
                                        </ComboBox>
                                    </StackPanel>
                                </local:HudPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ==================================================== 03 Keyboard -->
                <TabItem x:Name="KeyboardLightingPanel">
                    <TabItem.Header>
                        <StackPanel Classes="NavHeader" Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="KEYBOARD" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer Classes="Page" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <StackPanel Margin="0 0 0 20">
                                <TextBlock Text="KEYBOARD LIGHTING" Classes="PageTitle" />
                            </StackPanel>

                            <local:HudPanel Classes="Notice">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <material:MaterialIcon Kind="FlaskOutline" Width="14" Height="14" />
                                    <TextBlock Text="Experimental — this section needs more testing" />
                                </StackPanel>
                            </local:HudPanel>

                            <!-- Zone Color Control -->
                            <local:HudPanel x:Name="ZoneColorControlPanel" Classes="Card" Margin="0 0 0 16">
                                <StackPanel>
                                    <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="ZONE COLOURS" Classes="CardTitle" />
                                            <TextBlock Text="Static colour for each of the four keyboard zones"
                                                       Classes="CardCaption" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*,*,*">
                                        <local:HudPanel Grid.Column="0" Classes="Tile" Margin="0 0 6 0">
                                            <StackPanel>
                                                <TextBlock Text="ZONE 01" Classes="TileTitle" />
                                                <ColorPicker x:Name="Zone1ColorPicker" IsAlphaEnabled="False"
                                                             IsAlphaVisible="False" Color="#4287f5"
                                                             HorizontalAlignment="Stretch" Height="36" />
                                            </StackPanel>
                                        </local:HudPanel>
                                        <local:HudPanel Grid.Column="1" Classes="Tile" Margin="6 0 6 0">
                                            <StackPanel>
                                                <TextBlock Text="ZONE 02" Classes="TileTitle" />
                                                <ColorPicker x:Name="Zone2ColorPicker" IsAlphaEnabled="False"
                                                             HexInputAlphaPosition="Trailing" Color="#ff5733"
                                                             HorizontalAlignment="Stretch" Height="36" />
                                            </StackPanel>
                                        </local:HudPanel>
                                        <local:HudPanel Grid.Column="2" Classes="Tile" Margin="6 0 6 0">
                                            <StackPanel>
                                                <TextBlock Text="ZONE 03" Classes="TileTitle" />
                                                <ColorPicker x:Name="Zone3ColorPicker" IsAlphaEnabled="False"
                                                             HexInputAlphaPosition="Trailing" Color="#33ff57"
                                                             HorizontalAlignment="Stretch" Height="36" />
                                            </StackPanel>
                                        </local:HudPanel>
                                        <local:HudPanel Grid.Column="3" Classes="Tile" Margin="6 0 0 0">
                                            <StackPanel>
                                                <TextBlock Text="ZONE 04" Classes="TileTitle" />
                                                <ColorPicker x:Name="Zone4ColorPicker" IsAlphaEnabled="False"
                                                             HexInputAlphaPosition="Trailing" Color="#FFFF01"
                                                             HorizontalAlignment="Stretch" Height="36" />
                                            </StackPanel>
                                        </local:HudPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0 16 0 0">
                                        <TextBlock Grid.Column="0" Text="BRIGHTNESS" Classes="FieldLabel" />
                                        <Slider x:Name="KeyBrightnessSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                                TickFrequency="5" IsSnapToTickEnabled="True" Value="100" />
                                        <local:HudPanel Grid.Column="2" Classes="Readout">
                                            <TextBlock x:Name="KeyBrightnessText" Text="100%" />
                                        </local:HudPanel>
                                    </Grid>

                                    <Button x:Name="ApplyKeyboardColorsButton" Content="APPLY ZONE COLOURS"
                                            Classes="Primary" HorizontalAlignment="Left" Margin="0 16 0 0" />
                                </StackPanel>
                            </local:HudPanel>

                            <!-- Lighting Effects -->
                            <local:HudPanel x:Name="KeyboardEffectsPanel" Classes="Card" Margin="0 0 0 16">
                                <StackPanel>
                                    <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="LIGHTING EFFECTS" Classes="CardTitle" />
                                            <TextBlock Text="Dynamic effects for the whole keyboard"
                                                       Classes="CardCaption" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="MODE" Classes="FieldLabel" />
                                        <ComboBox x:Name="LightingModeComboBox" Grid.Row="0" Grid.Column="1"
                                                  SelectedIndex="0" MinWidth="220" HorizontalAlignment="Left"
                                                  Margin="0 0 0 12">
                                            <ComboBoxItem Content="Static Mode" />
                                            <ComboBoxItem Content="Breathing Mode" />
                                            <ComboBoxItem Content="Neon Mode" />
                                            <ComboBoxItem Content="Wave Mode" />
                                            <ComboBoxItem Content="Shifting Mode" />
                                            <ComboBoxItem Content="Zoom Mode" />
                                            <ComboBoxItem Content="Meteor Mode" />
                                            <ComboBoxItem Content="Twinkling Mode" />
                                        </ComboBox>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="SPEED" Classes="FieldLabel" />
                                        <Slider x:Name="LightingSpeedSlider" Grid.Row="1" Grid.Column="1" Value="5"
                                                Minimum="0" Maximum="9" IsSnapToTickEnabled="True" TickFrequency="1"
                                                Margin="0 0 0 12" />
                                        <local:HudPanel Grid.Row="1" Grid.Column="2" Classes="Readout"
                                                        Margin="12 0 0 12">
                                            <TextBlock x:Name="LightSpeedTextBlock" Text="5" />
                                        </local:HudPanel>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="COLOUR" Classes="FieldLabel" />
                                        <ColorPicker x:Name="LightEffectColorPicker" Grid.Row="2" Grid.Column="1"
                                                     IsAlphaEnabled="False" HexInputAlphaPosition="Trailing"
                                                     Color="#FFFF01" HorizontalAlignment="Left"
                                                     Height="36" Width="220" Margin="0 0 0 12" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="DIRECTION"
                                                   Classes="FieldLabel" />
                                        <UniformGrid Grid.Row="3" Grid.Column="1" Rows="1" HorizontalAlignment="Left"
                                                     Width="260">
                                            <RadioButton x:Name="LeftToRightRadioButton" GroupName="DirectionGroup"
                                                         Theme="{StaticResource SegmentRadio}" IsChecked="True"
                                                         Margin="0 0 6 0">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <material:MaterialIcon Kind="ArrowRight" Width="14" Height="14" />
                                                    <TextBlock Text="L → R" />
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="RightToLeftRadioButton" GroupName="DirectionGroup"
                                                         Theme="{StaticResource SegmentRadio}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <material:MaterialIcon Kind="ArrowLeft" Width="14" Height="14" />
                                                    <TextBlock Text="R → L" />
                                                </StackPanel>
                                            </RadioButton>
                                        </UniformGrid>
                                    </Grid>

                                    <Button x:Name="LightingEffectsApplyButton" Content="APPLY EFFECT"
                                            Classes="Primary" HorizontalAlignment="Left" Margin="0 16 0 0" />
                                </StackPanel>
                            </local:HudPanel>

                            <!-- Backlight Timeout -->
                            <local:HudPanel x:Name="BacklightTimeoutControls" Classes="Card" Margin="0 0 0 16">
                                <StackPanel>
                                    <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="BACKLIGHT TIMEOUT" Classes="CardTitle" />
                                            <TextBlock Classes="CardCaption"
                                                       Text="Turn the keyboard lighting off after 30 s of inactivity" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox x:Name="BacklightTimeoutCheckBox"
                                              Content="Enable backlight timeout (30 seconds)" IsChecked="True" />
                                </StackPanel>
                            </local:HudPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ==================================================== 04 System -->
                <TabItem x:Name="SystemSettingsPanel">
                    <TabItem.Header>
                        <StackPanel Classes="NavHeader" Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="SYSTEM" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer Classes="Page" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <StackPanel Margin="0 0 0 20">
                                <TextBlock Text="SYSTEM" Classes="PageTitle" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*">
                                <!-- LCD Override -->
                                <local:HudPanel x:Name="LcdOverrideControls" Classes="Card" Grid.Column="0"
                                                Margin="0 0 8 16">
                                    <StackPanel>
                                        <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="LCD OVERRIDE" Classes="CardTitle" />
                                                <TextBlock Text="Reduce LCD latency and minimize ghosting"
                                                           Classes="CardCaption" />
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox x:Name="LcdOverrideCheckBox" Content="Enable LCD override"
                                                  IsChecked="True" />
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0 8 0 0">
                                            <material:MaterialIcon Kind="AlertOutline" Width="14" Height="14"
                                                                   Classes="Danger" />
                                            <TextBlock Text="May increase battery consumption" Classes="Hint Warning" />
                                        </StackPanel>
                                    </StackPanel>
                                </local:HudPanel>

                                <!-- Boot Sound and Animation -->
                                <local:HudPanel x:Name="BootSoundControls" Classes="Card" Grid.Column="1"
                                                Margin="8 0 0 16">
                                    <StackPanel>
                                        <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="BOOT ANIMATION + SOUND" Classes="CardTitle" />
                                                <TextBlock Text="Custom boot animation and sound"
                                                           Classes="CardCaption" />
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox x:Name="BootAnimAndSoundCheckBox"
                                                  Content="Enable boot animation and sound" IsChecked="False" />
                                    </StackPanel>
                                </local:HudPanel>
                            </Grid>

                            <!-- System Information -->
                            <local:HudPanel Classes="Card" Margin="0 0 0 16">
                                <StackPanel>
                                    <Grid Classes="CardHeader" ColumnDefinitions="Auto,*">
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="SYSTEM INFORMATION" Classes="CardTitle" />
                                            <TextBlock Text="Detected hardware and component versions"
                                                       Classes="CardCaption" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Classes="KeyValue" ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="MODEL" Classes="Label" />
                                        <local:DotLeader Grid.Column="1" />
                                        <TextBlock x:Name="ModelNameText" Grid.Column="2" Text="UNKNOWN"
                                                   Classes="Value" />
                                    </Grid>
                                    <Grid Classes="KeyValue" ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="LAPTOP TYPE" Classes="Label" />
                                        <local:DotLeader Grid.Column="1" />
                                        <TextBlock x:Name="LaptopTypeText" Grid.Column="2" Text="UNKNOWN"
                                                   Classes="Value" />
                                    </Grid>
                                    <Grid Classes="KeyValue" ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="DAEMON" Classes="Label" />
                                        <local:DotLeader Grid.Column="1" />
                                        <TextBlock x:Name="DaemonVersionText" Grid.Column="2" Text="UNKNOWN"
                                                   Classes="Value" />
                                    </Grid>
                                    <Grid Classes="KeyValue" ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="DRIVER" Classes="Label" />
                                        <local:DotLeader Grid.Column="1" />
                                        <TextBlock x:Name="DriverVersionText" Grid.Column="2" Text="UNKNOWN"
                                                   Classes="Value" />
                                    </Grid>
                                    <Grid Classes="KeyValue" ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="APP" Classes="Label" />
                                        <local:DotLeader Grid.Column="1" />
                                        <TextBlock x:Name="ProjectVersionText" Grid.Column="2" Text="UNKNOWN"
                                                   Classes="Value" />
                                    </Grid>
                                    <StackPanel Margin="0 8 0 0">
                                        <TextBlock Text="FEATURES" Classes="Label" />
                                        <TextBlock x:Name="SupportedFeaturesTextBlock" Text="UNKNOWN" Classes="Value"
                                                   Margin="0 6 0 0" TextWrapping="Wrap"
                                                   Foreground="{StaticResource InkSecondaryBrush}" />
                                    </StackPanel>

                                    <WrapPanel Orientation="Horizontal" Margin="0 20 0 0">
                                        <Button x:Name="UpdatesButton" Content="CHECK FOR UPDATES" Classes="Spaced"
                                                Click="UpdatesButton_OnClick" />
                                        <Button x:Name="DeveloperModeButton" Content="DEVELOPER MODE"
                                                Classes="Spaced" IsVisible="False"
                                                Click="DeveloperMode_OnClick" />
                                        <Button x:Name="IssuePageButton" Content="ISSUES / FEEDBACK"
                                                Classes="Spaced" Click="IssuePageButton_OnClick" />
                                        <Button x:Name="InternalsManagerButton" Content="INTERNALS MANAGER"
                                                Classes="Spaced" Click="InternalsMangerWindow_OnClick" />
                                    </WrapPanel>
                                </StackPanel>
                            </local:HudPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ============================================================ Status toast (non-blocking) -->
        <local:HudPanel x:Name="StatusToast" Grid.Row="1" Classes="Toast" IsVisible="False" ZIndex="90"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0 0 24 24"
                        MaxWidth="560">
            <Grid ColumnDefinitions="Auto,*">
                <Ellipse x:Name="StatusToastDot" Classes="StatusDot" Margin="0 4 10 0" VerticalAlignment="Top" />
                <TextBlock x:Name="StatusToastText" Grid.Column="1" TextWrapping="Wrap"
                           Foreground="{StaticResource InkBrush}" />
            </Grid>
        </local:HudPanel>

        <!-- ============================================================ Daemon overlay -->
        <Grid x:Name="DaemonErrorGrid" Grid.Row="1" ZIndex="100" Background="{StaticResource OverlayScrimBrush}"
              IsHitTestVisible="True" IsVisible="True">
            <local:HudPanel Width="540" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Cut="16" Padding="28 24"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource LineStrongBrush}"
                            BorderThickness="1">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*">
                        <material:MaterialIcon Kind="LanDisconnect" Classes="Danger"
                                               Width="22" Height="22" VerticalAlignment="Center" />
                        <TextBlock x:Name="DaemonErrorTitle" Grid.Column="1" Text="DAEMON OFFLINE"
                                   Margin="12 0 0 0" Classes="PageTitle" VerticalAlignment="Center" />
                    </Grid>
                    <Border Classes="Rule" Margin="0 8 0 8" />

                    <TextBlock x:Name="DaemonErrorMessage" TextWrapping="Wrap" Classes="Body"
                               Text="Connecting to the DAMX daemon…" />
                    <TextBlock Classes="Hint" Margin="0 0 0 12"
                               Text="The daemon may still be initializing. Logs: /var/log/DAMX_Daemon_Log.log" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="RETRY CONNECTION" Classes="Primary"
                                Click="RetryConnectionButton_OnClick" />
                        <Button Content="CONTINUE OFFLINE"
                                Click="DismissDaemonErrorButton_OnClick" />
                    </StackPanel>
                </StackPanel>
            </local:HudPanel>
        </Grid>
    </Grid>
</Window>
